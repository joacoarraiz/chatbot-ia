# =====================================================
# .env.example
# Plantilla de credenciales. Copialo como .env (sin "example")
# y completá los valores reales. NUNCA subir el .env al repo.
# =====================================================

# --- Supabase (base de datos y storage) ---
# Las conseguís en: Supabase > Project Settings > API
SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# --- OpenAI (LLM + transcripción de audios) ---
# La conseguís en: platform.openai.com > API keys
OPENAI_API_KEY=sk-...

# Modelos a usar (no cambiar a menos que sepas lo que hacés)
MODEL_ROUTER=gpt-4.1-mini
MODEL_SPECIALIST=gpt-4.1
MODEL_TRANSCRIBE=gpt-4o-mini-transcribe

# --- WhatsApp Cloud API (Meta) ---
# Las conseguís después de la Etapa 2 de la certificación Meta.
# Mientras tanto, dejalas vacías o con valores placeholder.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=toni_verify_2026

# --- Empresa piloto ---
# El ID de la primera empresa en la tabla `empresa` de Supabase.
# Si seguiste los pasos, es 1.
EMPRESA_ID_PILOTO=1

# --- Entorno ---
# Cambia el comportamiento del bot. Opciones: development, production
ENV=development
LOG_LEVEL=INFO
