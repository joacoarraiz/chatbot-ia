[36m@@ -0,0 +1,205 @@[m
[32m+[m[32m"""[m
[32m+[m[32mtests/test_connections.py[m
[32m+[m[32mVerifica que el entorno está bien configurado:[m
[32m+[m[32m  1. Las variables del .env están cargadas.[m
[32m+[m[32m  2. Se conecta a Supabase y puede leer la tabla empresa.[m
[32m+[m[32m  3. Se conecta a OpenAI y obtiene respuesta del modelo router.[m
[32m+[m[32m  4. Las RPC del catálogo están vivas (rpc_buscar_por_aplicacion).[m
[32m+[m
[32m+[m[32mSi todo pasa, queda confirmado que podemos arrancar a programar el bot.[m
[32m+[m[32m"""[m
[32m+[m[32mfrom __future__ import annotations[m
[32m+[m
[32m+[m[32mimport os[m
[32m+[m[32mimport sys[m
[32m+[m[32mfrom pathlib import Path[m
[32m+[m
[32m+[m[32m# Permitir imports desde la raíz del proyecto[m
[32m+[m[32msys.path.insert(0, str(Path(__file__).parent.parent))[m
[32m+[m
[32m+[m[32mfrom dotenv import load_dotenv[m
[32m+[m[32mload_dotenv()[m
[32m+[m
[32m+[m
[32m+[m[32m# ============ Helpers de output ============[m
[32m+[m
[32m+[m[32mdef ok(msg: str): print(f"  ✅ {msg}")[m
[32m+[m[32mdef fail(msg: str): print(f"  ❌ {msg}")[m
[32m+[m[32mdef info(msg: str): print(f"  ℹ️  {msg}")[m
[32m+[m[32mdef step(n: int, total: int, title: str):[m
[32m+[m[32m    print(f"\n[{n}/{total}] {title}")[m
[32m+[m[32m    print("─" * 50)[m
[32m+[m
[32m+[m
[32m+[m[32m# ============ TEST 1: variables del .env ============[m
[32m+[m
[32m+[m[32mdef test_env_vars() -> bool:[m
[32m+[m[32m    step(1, 4, "Verificando variables de entorno (.env)")[m
[32m+[m
[32m+[m[32m    requeridas = [[m
[32m+[m[32m        "SUPABASE_URL",[m
[32m+[m[32m        "SUPABASE_ANON_KEY",[m
[32m+[m[32m        "SUPABASE_SERVICE_ROLE_KEY",[m
[32m+[m[32m        "OPENAI_API_KEY",[m
[32m+[m[32m        "EMPRESA_ID_PILOTO",[m
[32m+[m[32m    ][m
[32m+[m[32m    opcionales = [[m
[32m+[m[32m        "WHATSAPP_PHONE_NUMBER_ID",[m
[32m+[m[32m        "WHATSAPP_ACCESS_TOKEN",[m
[32m+[m[32m        "WHATSAPP_APP_SECRET",[m
[32m+[m[32m    ][m
[32m+[m
[32m+[m[32m    todo_ok = True[m
[32m+[m[32m    for var in requeridas:[m
[32m+[m[32m        val = os.environ.get(var)[m
[32m+[m[32m        if not val:[m
[32m+[m[32m            fail(f"{var} FALTANTE (es obligatoria)")[m
[32m+[m[32m            todo_ok = False[m
[32m+[m[32m        elif val.startswith("TU_") or val == "sk-..." or val.startswith("eyJhbGc..."):[m
[32m+[m[32m            fail(f"{var} tiene el valor de ejemplo, no la credencial real")[m
[32m+[m[32m            todo_ok = False[m
[32m+[m[32m        else:[m
[32m+[m[32m            # Mostrar solo los primeros 10 chars de las keys para no leakear[m
[32m+[m[32m            preview = val[:15] + "..." if len(val) > 20 else val[m
[32m+[m[32m            ok(f"{var} = {preview}")[m
[32m+[m
[32m+[m[32m    for var in opcionales:[m
[32m+[m[32m        val = os.environ.get(var)[m
[32m+[m[32m        if val:[m
[32m+[m[32m            preview = val[:15] + "..." if len(val) > 20 else val[m
[32m+[m[32m            ok(f"{var} = {preview}  (opcional)")[m
[32m+[m[32m        else:[m
[32m+[m[32m            info(f"{var} vacía  (opcional, se completa cuando llegue de Meta)")[m
[32m+[m
[32m+[m[32m    return todo_ok[m
[32m+[m
[32m+[m
[32m+[m[32m# ============ TEST 2: conexión a Supabase ============[m
[32m+[m
[32m+[m[32mdef test_supabase() -> bool:[m
[32m+[m[32m    step(2, 4, "Conectando a Supabase")[m
[32m+[m
[32m+[m[32m    try:[m
[32m+[m[32m        from functions.db import get_client[m
[32m+[m[32m        sb = get_client()[m
[32m+[m
[32m+[m[32m        # Leer la empresa piloto[m
[32m+[m[32m        empresa_id = int(os.environ["EMPRESA_ID_PILOTO"])[m
[32m+[m[32m        response = sb.table("empresa").select("*").eq("id", empresa_id).execute()[m
[32m+[m
[32m+[m[32m        if not response.data:[m
[32m+[m[32m            fail(f"No encontré la empresa con id={empresa_id} en la tabla empresa.")[m
[32m+[m[32m            return False[m
[32m+[m
[32m+[m[32m        empresa = response.data[0][m
[32m+[m[32m        ok(f"Empresa piloto encontrada: '{empresa['nombre']}' (id={empresa['id']}, plan={empresa['plan']})")[m
[32m+[m
[32m+[m[32m        # Contar productos[m
[32m+[m[32m        prods = sb.table("producto_logico").select("id", count="exact").eq("empresa_id", empresa_id).execute()[m
[32m+[m[32m        ok(f"Productos en catálogo: {prods.count or 0}")[m
[32m+[m
[32m+[m[32m        return True[m
[32m+[m
[32m+[m[32m    except Exception as e:[m
[32m+[m[32m        fail(f"Error conectando a Supabase: {e}")[m
[32m+[m[32m        return False[m
[32m+[m
[32m+[m
[32m+[m[32m# ============ TEST 3: conexión a OpenAI ============[m
[32m+[m
[32m+[m[32mdef test_openai() -> bool:[m
[32m+[m[32m    step(3, 4, "Conectando a OpenAI")[m
[32m+[m
[32m+[m[32m    try:[m
[32m+[m[32m        from openai import OpenAI[m
[32m+[m[32m        client = OpenAI(api_key=os.environ["OPENAI_API_KEY"])[m
[32m+[m
[32m+[m[32m        # Pedir una respuesta corta al modelo router[m
[32m+[m[32m        model = os.environ.get("MODEL_ROUTER", "gpt-4.1-mini")[m
[32m+[m[32m        response = client.chat.completions.create([m
[32m+[m[32m            model=model,[m
[32m+[m[32m            messages=[[m
[32m+[m[32m                {"role": "user", "content": "Decí solamente: hola toni"},[m
[32m+[m[32m            ],[m
[32m+[m[32m            max_tokens=20,[m
[32m+[m[32m        )[m
[32m+[m[32m        respuesta = response.choices[0].message.content.strip()[m
[32m+[m[32m        ok(f"Modelo '{model}' respondió: '{respuesta}'")[m
[32m+[m[32m        ok(f"Tokens usados: {response.usage.total_tokens}")[m
[32m+[m[32m        return True[m
[32m+[m
[32m+[m[32m    except Exception as e:[m
[32m+[m[32m        fail(f"Error conectando a OpenAI: {e}")[m
[32m+[m[32m        info("Posibles causas:")[m
[32m+[m[32m        info("  • API key inválida o expirada")[m
[32m+[m[32m        info("  • Sin saldo cargado en la cuenta")[m
[32m+[m[32m        info("  • Modelo no disponible para esta cuenta (probar con gpt-4o-mini)")[m
[32m+[m[32m        return False[m
[32m+[m
[32m+[m
[32m+[m[32m# ============ TEST 4: RPC del catálogo ============[m
[32m+[m
[32m+[m[32mdef test_catalog_rpc() -> bool:[m
[32m+[m[32m    step(4, 4, "Verificando RPC del catálogo")[m
[32m+[m
[32m+[m[32m    try:[m
[32m+[m[32m        from functions.catalog_tools import buscar_por_aplicacion[m
[32m+[m
[32m+[m[32m        # Búsqueda de prueba: VW Gol 2010[m
[32m+[m[32m        resultados = buscar_por_aplicacion([m
[32m+[m[32m            marca="VW",[m
[32m+[m[32m            modelo="Gol",[m
[32m+[m[32m            anio=2010,[m
[32m+[m[32m            limit=3,[m
[32m+[m[32m        )[m
[32m+[m
[32m+[m[32m        if not resultados:[m
[32m+[m[32m            info("La RPC respondió pero no devolvió productos para VW Gol 2010.")[m
[32m+[m[32m            info("Esto no es necesariamente un error: depende del catálogo.")[m
[32m+[m[32m            return True[m
[32m+[m
[32m+[m[32m        ok(f"RPC funcionando, devolvió {len(resultados)} productos para VW Gol 2010:")[m
[32m+[m[32m        for r in resultados[:3]:[m
[32m+[m[32m            desc = r.get("descripcion", "")[:60][m
[32m+[m[32m            stock = r.get("stock_total", 0)[m
[32m+[m[32m            ok(f"    • {desc}... (stock: {stock})")[m
[32m+[m[32m        return True[m
[32m+[m
[32m+[m[32m    except Exception as e:[m
[32m+[m[32m        fail(f"Error llamando a la RPC: {e}")[m
[32m+[m[32m        return False[m
[32m+[m
[32m+[m
[32m+[m[32m# ============ Main ============[m
[32m+[m
[32m+[m[32mdef main():[m
[32m+[m[32m    print("=" * 50)[m
[32m+[m[32m    print("  TONI — Test de conexiones del entorno")[m
[32m+[m[32m    print("=" * 50)[m
[32m+[m
[32m+[m[32m    resultados = {[m
[32m+[m[32m        "env": test_env_vars(),[m
[32m+[m[32m        "supabase": test_supabase(),[m
[32m+[m[32m        "openai": test_openai(),[m
[32m+[m[32m        "rpc": test_catalog_rpc(),[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    print()[m
[32m+[m[32m    print("=" * 50)[m
[32m+[m[32m    print("  RESUMEN")[m
[32m+[m[32m    print("=" * 50)[m
[32m+[m[32m    for nombre, ok_val in resultados.items():[m
[32m+[m[32m        emoji = "✅" if ok_val else "❌"[m
[32m+[m[32m        print(f"  {emoji} {nombre}")[m
[32m+[m[32m    print()[m
[32m+[m
[32m+[m[32m    if all(resultados.values()):[m
[32m+[m[32m        print("🎉 Todo OK. El entorno está listo para programar el bot.")[m
[32m+[m[32m        sys.exit(0)[m
[32m+[m[32m    else:[m
[32m+[m[32m        print("⚠️  Hay algo que arreglar. Mirá los errores arriba.")[m
[32m+[m[32m        sys.exit(1)[m
[32m+[m
[32m+[m
[32m+[m[32mif __name__ == "__main__":[m
[32m+[m[32m    main()[m
