[36m@@ -0,0 +1,48 @@[m
[32m+[m[32m"""[m
[32m+[m[32mscripts/compute_scores.py[m
[32m+[m[32mJob que evalúa conversaciones cerradas y les asigna un score 0-100.[m
[32m+[m[32m4 componentes determinísticos + 1 que usa el LLM auditor.[m
[32m+[m
[32m+[m[32mSe corre como cron job una vez por noche.[m
[32m+[m[32m"""[m
[32m+[m[32mfrom __future__ import annotations[m
[32m+[m
[32m+[m[32mimport json[m
[32m+[m[32mimport os[m
[32m+[m[32mimport sys[m
[32m+[m[32mfrom datetime import datetime, timedelta[m
[32m+[m[32mfrom pathlib import Path[m
[32m+[m
[32m+[m[32m# Permitir imports desde la raíz del proyecto[m
[32m+[m[32msys.path.insert(0, str(Path(__file__).parent.parent))[m
[32m+[m
[32m+[m[32mfrom dotenv import load_dotenv[m
[32m+[m[32mload_dotenv()[m
[32m+[m
[32m+[m[32mfrom functions.db import get_client[m
[32m+[m
[32m+[m
[32m+[m[32mdef main():[m
[32m+[m[32m    sb = get_client()[m
[32m+[m
[32m+[m[32m    # Conversaciones cerradas en las últimas 24 horas, sin score aún[m
[32m+[m[32m    ayer = (datetime.utcnow() - timedelta(days=1)).isoformat()[m
[32m+[m
[32m+[m[32m    consultas = ([m
[32m+[m[32m        sb.table("consulta")[m
[32m+[m[32m          .select("*, conversacion(*)")[m
[32m+[m[32m          .eq("estado", "cerrada")[m
[32m+[m[32m          .gte("cerrada_at", ayer)[m
[32m+[m[32m          .execute()[m
[32m+[m[32m    )[m
[32m+[m
[32m+[m[32m    print(f"Encontradas {len(consultas.data or [])} consultas para scorear.")[m
[32m+[m
[32m+[m[32m    for c in consultas.data or []:[m
[32m+[m[32m        # Acá iría la lógica completa de evaluación.[m
[32m+[m[32m        # Por ahora dejamos el esqueleto.[m
[32m+[m[32m        print(f"  Consulta {c['id']}: pendiente de implementación.")[m
[32m+[m
[32m+[m
[32m+[m[32mif __name__ == "__main__":[m
[32m+[m[32m    main()[m
