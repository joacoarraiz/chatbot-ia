[31m--- =====================================================[m
[31m--- 02_clients.sql[m
[31m--- Clientes finales (los que chatean con el bot),[m
[31m--- sus identidades por canal y sus vehículos.[m
[31m--- Correr DESPUÉS de 01_catalog.sql.[m
[31m--- =====================================================[m
[31m-[m
[31m--- ----- CLIENTE -----[m
[31m--- Un cliente final, con stats agregadas.[m
[31m--- Identidad por (empresa, persona): el mismo número puede ser cliente[m
[31m--- de 2 comercios distintos y se trata como dos clientes diferentes.[m
[31m-CREATE TABLE IF NOT EXISTS cliente ([m
[31m-  id BIGSERIAL PRIMARY KEY,[m
[31m-  empresa_id BIGINT REFERENCES empresa ON DELETE CASCADE,[m
[31m-  nombre TEXT,                                  -- si lo dio en algún momento[m
[31m-  tipo TEXT DEFAULT 'b2c',                      -- 'b2c'|'b2b'[m
[31m-  notas TEXT,                                   -- texto libre del CRM[m
[31m-  preferencias JSONB,                           -- {"original": true, "retira_local": true}[m
[31m-[m
[31m-  -- Stats agregadas (recalculadas por job nocturno)[m
[31m-  total_consultas INT DEFAULT 0,[m
[31m-  total_compras INT DEFAULT 0,[m
[31m-  monto_acumulado NUMERIC(14,2) DEFAULT 0,[m
[31m-  primera_actividad_at TIMESTAMPTZ,[m
[31m-  ultima_actividad_at TIMESTAMPTZ,[m
[31m-[m
[31m-  -- Etiquetas calculadas: 'recurrente', 'candidato_b2b', 'dormido', 'frio'[m
[31m-  etiquetas TEXT[],[m
[31m-[m
[31m-  creado_at TIMESTAMPTZ DEFAULT now()[m
[31m-);[m
[31m-CREATE INDEX IF NOT EXISTS idx_cliente_empresa ON cliente(empresa_id);[m
[31m-CREATE INDEX IF NOT EXISTS idx_cliente_ultima[m
[31m-  ON cliente(empresa_id, ultima_actividad_at DESC);[m
[31m-CREATE INDEX IF NOT EXISTS idx_cliente_etiquetas[m
[31m-  ON cliente USING gin(etiquetas);[m
[31m-[m
[31m--- ----- CONTACT CHANNEL -----[m
[31m--- Identificadores del cliente en cada canal (WhatsApp, ML, web, etc).[m
[31m--- Permite unir al mismo cliente que aparece en varios canales.[m
[31m-CREATE TABLE IF NOT EXISTS contact_channel ([m
[31m-  id BIGSERIAL PRIMARY KEY,[m
[31m-  cliente_id BIGINT REFERENCES cliente ON DELETE CASCADE,[m
[31m-  canal TEXT NOT NULL,                          -- 'whatsapp'|'ml'|'web'|'instagram'[m
[31m-  identificador TEXT NOT NULL,                  -- E.164 / user_id / session_id[m
[31m-  display_name TEXT,                            -- nombre que muestra el canal[m
[31m-  verificado BOOLEAN DEFAULT true,[m
[31m-  creado_at TIMESTAMPTZ DEFAULT now(),[m
[31m-  UNIQUE(canal, identificador)[m
[31m-);[m
[31m-CREATE INDEX IF NOT EXISTS idx_cc_cliente ON contact_channel(cliente_id);[m
[31m-CREATE INDEX IF NOT EXISTS idx_cc_canal_id ON contact_channel(canal, identificador);[m
[31m-[m
[31m--- ----- VEHÍCULO DEL CLIENTE -----[m
[31m--- Los autos asociados a un cliente. Memoria del bot.[m
[31m-CREATE TABLE IF NOT EXISTS vehiculo_cliente ([m
[31m-  id BIGSERIAL PRIMARY KEY,[m
[31m-  cliente_id BIGINT REFERENCES cliente ON DELETE CASCADE,[m
[31m-  marca TEXT NOT NULL,[m
[31m-  modelo TEXT NOT NULL,[m
[31m-  anio INT,[m
[31m-  motor TEXT,                                   -- "1.6", "1.4 TDI", etc.[m
[31m-  version TEXT,[m
