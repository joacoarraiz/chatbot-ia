[36m@@ -0,0 +1,43 @@[m
[32m+[m[32m"""[m
[32m+[m[32mfunctions/db.py[m
[32m+[m[32mCliente unificado de Supabase. Otros módulos del bot importan[m
[32m+[m[32mdesde acá para hablar con la base de datos.[m
[32m+[m[32m"""[m
[32m+[m[32mfrom __future__ import annotations[m
[32m+[m
[32m+[m[32mimport os[m
[32m+[m[32mfrom functools import lru_cache[m
[32m+[m
[32m+[m[32mfrom supabase import create_client, Client[m
[32m+[m
[32m+[m
[32m+[m[32m@lru_cache(maxsize=1)[m
[32m+[m[32mdef get_client() -> Client:[m
[32m+[m[32m    """[m
[32m+[m[32m    Devuelve un cliente de Supabase usando la service_role key.[m
[32m+[m[32m    El bot usa service_role porque necesita bypassear RLS para[m
[32m+[m[32m    operar como sistema (no como un usuario humano).[m
[32m+[m[32m    """[m
[32m+[m[32m    url = os.environ.get("SUPABASE_URL")[m
[32m+[m[32m    key = os.environ.get("SUPABASE_SERVICE_ROLE_KEY")[m
[32m+[m
[32m+[m[32m    if not url or not key:[m
[32m+[m[32m        raise RuntimeError([m
[32m+[m[32m            "Faltan SUPABASE_URL o SUPABASE_SERVICE_ROLE_KEY en el .env. "[m
[32m+[m[32m            "Revisá que el archivo .env exista y tenga las dos variables."[m
[32m+[m[32m        )[m
[32m+[m
[32m+[m[32m    return create_client(url, key)[m
[32m+[m
[32m+[m
[32m+[m[32m@lru_cache(maxsize=1)[m
[32m+[m[32mdef get_anon_client() -> Client:[m
[32m+[m[32m    """[m
[32m+[m[32m    Cliente con la anon key (sin permisos especiales). Útil para[m
[32m+[m[32m    operaciones del dashboard que respetan RLS.[m
[32m+[m[32m    """[m
[32m+[m[32m    url = os.environ.get("SUPABASE_URL")[m
[32m+[m[32m    key = os.environ.get("SUPABASE_ANON_KEY")[m
[32m+[m[32m    if not url or not key:[m
[32m+[m[32m        raise RuntimeError("Faltan SUPABASE_URL o SUPABASE_ANON_KEY en el .env.")[m
[32m+[m[32m    return create_client(url, key)[m
