[36m@@ -0,0 +1,26 @@[m
[32m+[m[32m-- =====================================================[m
[32m+[m[32m-- 05_rls.sql[m
[32m+[m[32m-- Row Level Security: cada empresa solo ve sus datos.[m
[32m+[m[32m-- =====================================================[m
[32m+[m
[32m+[m[32mALTER TABLE empresa ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE fuente_catalogo ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE producto_logico ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE oferta ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE aplicacion ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE equivalencia ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE regla_precio ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE cliente ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE contact_channel ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE vehiculo_cliente ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE conversacion ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE mensaje ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE consulta ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE intencion_log ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE pedido ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE pedido_item ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE derivacion ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE score_consulta ENABLE ROW LEVEL SECURITY;[m
[32m+[m
[32m+[m[32m-- El service_role bypassa RLS automáticamente, así que el bot funciona.[m
[32m+[m[32m-- Las policies específicas para usuarios del dashboard se definen después.[m
[1mdiff --git a/docs/Diseno_Tecnico_Etapa1.md b/docs/Diseno_Tecnico_Etapa1.md[m
[1mnew file mode 100644[m
[1mindex 0000000..ced8668[m
[1m--- /dev/null[m
[1m+++ b/docs/Diseno_Tecnico_Etapa1.md[m
[36m@@ -0,0 +1,22 @@[m
[32m+[m[32m# Toni — Diseño Técnico Etapa 1[m
[32m+[m
[32m+[m[32mEste documento es el resumen del diseño técnico aprobado en mayo 2026.[m
[32m+[m[32mPara el detalle completo, ver el archivo original en el proyecto.[m
[32m+[m
[32m+[m[32m## Decisiones clave[m
[32m+[m
[32m+[m[32m- **Definición de consulta**: ventana de 30 minutos, agrupa mensajes de una misma intención.[m
[32m+[m[32m- **Arquitectura**: Router + 6 agentes especialistas.[m
[32m+[m[32m- **Base de datos**: 17 tablas en 4 bloques (catálogo, clientes, conversaciones, scoring).[m
[32m+[m[32m- **Scoring**: 5 componentes (4 determinísticos + 1 LLM auditor).[m
[32m+[m
[32m+[m[32m## Tablas principales[m
[32m+[m
[32m+[m[32mVer `db/` para los SQL completos.[m
[32m+[m
[32m+[m[32m| Bloque | Tablas |[m
[32m+[m[32m|---|---|[m
[32m+[m[32m| Catálogo | empresa, fuente_catalogo, producto_logico, oferta, aplicacion, equivalencia, regla_precio |[m
[32m+[m[32m| Clientes | cliente, contact_channel, vehiculo_cliente |[m
[32m+[m[32m| Conversaciones | conversacion, mensaje, consulta, intencion_log |[m
[32m+[m[32m| Scoring | pedido, pedido_item, derivacion, score_consulta |[m
[1mdiff --git a/docs/GUIA_GITHUB.md b/docs/GUIA_GITHUB.md[m
[1mnew file mode 100644[m
[1mindex 0000000..6c8619d[m
[1m--- /dev/null[m
[1m+++ b/docs/GUIA_GITHUB.md[m
[36m@@ -0,0 +1,30 @@[m
[32m+[m[32m# Guía rápida — GitHub[m
[32m+[m
[32m+[m[32m## Hacer cambios y subirlos[m
[32m+[m
[32m+[m[32m```bash[m
[32m+[m[32mgit add .[m
[32m+[m[32mgit commit -m "descripción breve del cambio"[m
[32m+[m[32mgit push origin main[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m## Bajar cambios del repo[m
[32m+[m
[32m+[m[32m```bash[m
[32m+[m[32mgit pull origin main[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m## Crear una rama para trabajar sin afectar la main[m
[32m+[m
[32m+[m[32m```bash[m
[32m+[m[32mgit checkout -b mi-rama[m
[32m+[m[32m# (hacés cambios)[m
[32m+[m[32mgit push origin mi-rama[m
[32m+[m[32m# Después abrir PR en github.com[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m## Si te trabás[m
[32m+[m
[32m+[m[32m- `git status` te muestra qué cambió.[m
[32m+[m[32m- `git log --oneline -10` los últimos 10 commits.[m
[32m+[m[32m- `git diff` lo que cambiaste vs el último commit.[m
[1mdiff --git a/docs/GUIA_SUPABASE.md b/docs/GUIA_SUPABASE.md[m
[1mnew file mode 100644[m
