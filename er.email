[31m-[m
[31m--- ----- APLICACIÓN -----[m
[31m--- A qué vehículos calza un producto.[m
[31m-CREATE TABLE IF NOT EXISTS aplicacion ([m
[31m-  id BIGSERIAL PRIMARY KEY,[m
[31m-  producto_id BIGINT REFERENCES producto_logico ON DELETE CASCADE,[m
[31m-  auto_marca TEXT NOT NULL,[m
[31m-  modelo TEXT NOT NULL,[m
[31m-  anio_desde INT,[m
[31m-  anio_hasta INT,[m
[31m-  motor TEXT,[m
