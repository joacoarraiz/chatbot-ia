[31m-[m
[31m-from functions.db import get_client[m
[31m-[m
[31m-[m
[31m-# ---------- Config del auditor ----------[m
[31m-[m
[31m-AGENTS_DIR = Path(__file__).parent.parent / "agents" / "auditor"[m
[31m-AUDITOR_PROMPT = (AGENTS_DIR / "prompt.md").read_text(encoding="utf-8")[m
[31m-AUDITOR_SCHEMA = json.loads((AGENTS_DIR / "schema.json").read_text(encoding="utf-8"))[m
[31m-AUDITOR_MODEL = os.getenv("LLM_MODEL_ESPECIALISTA", "claude-sonnet-4-5")[m
[31m-[m
[31m-[m
[31m-# ---------- Componentes determinísticos ----------[m
[31m-[m
[31m-def score_resolucion(consulta: dict, derivacion: dict | None) -> int:[m
[31m-    """0-40 según el resultado de la consulta."""[m
[31m-    resultado = consulta.get("resultado")[m
[31m-    estado = consulta.get("estado")[m
[31m-[m
[31m-    if resultado == "venta":[m
[31m-        return 40[m
[31m-    if resultado == "cotizacion":[m
[31m-        return 30[m
[31m-    if resultado == "derivacion":[m
[31m-        # Si derivó CON resumen completo, 20. Si pobre, 10.[m
[31m-        if derivacion and len((derivacion.get("resumen") or "").strip()) >= 80:[m
[31m-            return 20[m
[31m-        return 10[m
[31m-    if estado == "abandonada":[m
[31m-        return 0[m
[31m-    return 5  # caso raro / sin clasificar[m
[31m-[m
[31m-[m
[31m-def score_datos(mensajes: list[dict]) -> int:[m
[31m-    """[m
[31m-    0-20 según si las búsquedas devolvieron datos completos.[m
[31m-    Inspecciona el metadata de los mensajes del bot.[m
[31m-    """[m
[31m-    busquedas = [[m
[31m-        m for m in mensajes[m
[31m-        if m.get("emisor") == "bot" and (m.get("metadata") or {}).get("tool_calls")[m
[31m-    ][m
[31m-    if not busquedas:[m
[31m-        # No hubo búsquedas: la consulta no era de catálogo. No penalizar.[m
[31m-        return 20[m
[31m-[m
[31m-    completas = 0[m
[31m-    parciales = 0[m
[31m-    vacias = 0[m
[31m-    for m in busquedas:[m
[31m-        for tc in (m["metadata"].get("tool_calls") or []):[m
[31m-            result = tc.get("result") or {}[m
[31m-            if result.get("error") or not result.get("resultados"):[m
[31m-                vacias += 1[m
[31m-                continue[m
[31m-            # Chequear si la primera oferta tiene precio Y stock[m
[31m-            primera = (result.get("resultados") or [None])[0][m
[31m-            if primera and primera.get("precio_min") and primera.get("stock_total"):[m
[31m-                completas += 1[m
[31m-            else:[m
[31m-                parciales += 1[m
[31m-[m
[31m-    total = completas + parciales + vacias[m
[31m-    if total == 0:[m
[31m-        return 20[m
[31m-    if vacias > 0 and completas == 0:[m
[31m-        return 0[m
[31m-    if completas == total:[m
[31m-        return 20[m
[31m-    return 10  # mixto[m
[31m-[m
[31m-[m
[31m-def score_eficiencia(mensajes: list[dict]) -> int:[m
[31m-    """[m
[31m-    0-15. Cuenta cuántos turnos del bot fueron preguntas (desambiguación).[m
[31m-    Heurística simple: mensajes del bot que terminan en '?'.[m
[31m-    """[m
[31m-    preguntas_bot = sum([m
[31m-        1 for m in mensajes[m
[31m-        if m.get("emisor") == "bot" and "?" in (m.get("contenido") or "")[m
[31m-    )[m
[31m-    if preguntas_bot <= 3:[m
[31m-        return 15[m
[31m-    if preguntas_bot <= 6:[m
[31m-        return 8[m
[31m-    return 0[m
[31m-[m
[31m-[m
[31m-def score_conversion(consulta: dict, pedido: dict | None) -> int:[m
[31m-    """0-10."""[m
[31m-    if pedido and pedido.get("estado") in ("confirmado", "pagado", "entregado"):[m
[31m-        return 10[m
[31m-    if consulta.get("resultado") == "cotizacion":[m
[31m-        return 5[m
[31m-    return 0[m
[31m-[m
[31m-[m
[31m-# ---------- Componente subjetivo (LLM) ----------[m
[31m-[m
[31m-def score_tono_y_observaciones([m
[31m-    consulta: dict, mensajes: list[dict][m
[31m-) -> tuple[int, str, list[str]]:[m
[31m-    """Llama al auditor LLM y devuelve (tono, observaciones, oportunidades)."""[m
[31m-    client = anthropic.Anthropic(api_key=os.getenv("ANTHROPIC_API_KEY"))[m
[31m-[m
[31m-    conversacion_texto = "\n".join([m
[31m-        f"[{m['emisor']}]: {m.get('contenido','')}"[m
[31m-        for m in mensajes[m
[31m-    )[m
[31m-[m
[31m-    user_content = ([m
[31m-        f"## Datos estructurados\n"[m
[31m-        f"intencion: {consulta.get('intencion')}\n"[m
[31m-        f"resultado: {consulta.get('resultado')}\n"[m
[31m-        f"estado: {consulta.get('estado')}\n"[m
[31m-        f"monto_cotizado: {consulta.get('monto_cotizado')}\n\n"[m
[31m-        f"## Conversación\n{conversacion_texto}\n\n"[m
[31m-        f"Devolvé SOLO el JSON con score_tono, observaciones y oportunidades_mejora."[m
[31m-    )[m
[31m-[m
[31m-    response = client.messages.create([m
[31m-        model=AUDITOR_MODEL,[m
[31m-        max_tokens=600,[m
[31m-        temperature=0.2,[m
[31m-        system=AUDITOR_PROMPT,[m
[31m-        messages=[{"role": "user", "content": user_content}],[m
[31m-    )[m
[31m-[m
[31m-    raw = response.content[0].text.strip()[m
[31m-    data = _parse_json(raw)[m
[31m-[m
[31m-    try:[m
[31m-        validate(instance=data, schema=AUDITOR_SCHEMA)[m
