[36m@@ -1,206 +0,0 @@[m
[31m-"""[m
[31m-agents/router/router.py[m
[31m-Implementación del Router. Clasifica el mensaje del cliente y devuelve un[m
[31m-RouterOutput validado. NO responde al cliente.[m
[31m-[m
[31m-Uso:[m
[31m-    from agents.router.router import clasificar[m
[31m-    out = clasificar(mensaje, historial, cliente, config_empresa)[m
[31m-    if out.confianza < 0.6:[m
[31m-        # pedir desambiguación[m
[31m-    if out.cuenta_como_consulta:[m
[31m-        # abrir/cerrar/continuar consulta según intencion[m
[31m-"""[m
[31m-from __future__ import annotations[m
[31m-[m
[31m-import json[m
[31m-import os[m
[31m-import re[m
[31m-from dataclasses import dataclass, asdict[m
[31m-from pathlib import Path[m
[31m-from typing import Any[m
[31m-[m
[31m-import anthropic  # pip install anthropic[m
[31m-from jsonschema import validate, ValidationError  # pip install jsonschema[m
[31m-[m
[31m-[m
[31m-# ---------- Configuración ----------[m
[31m-[m
[31m-MODELO = os.getenv("LLM_MODEL_ROUTER", "claude-haiku-4-5")[m
[31m-MAX_TOKENS = 400  # JSON corto, no hace falta más[m
[31m-TEMPERATURA = 0.0  # clasificación: determinístico[m
[31m-[m
[31m-BASE_DIR = Path(__file__).parent[m
[31m-PROMPT_PATH = BASE_DIR / "prompt.md"[m
[31m-SCHEMA_PATH = BASE_DIR / "schema.json"[m
[31m-[m
[31m-SYSTEM_PROMPT = PROMPT_PATH.read_text(encoding="utf-8")[m
[31m-SCHEMA = json.loads(SCHEMA_PATH.read_text(encoding="utf-8"))[m
[31m-[m
[31m-[m
[31m-# ---------- Tipos ----------[m
[31m-[m
[31m-@dataclass[m
[31m-class DatosExtraidos:[m
[31m-    marca_auto: str | None = None[m
[31m-    modelo: str | None = None[m
[31m-    anio: int | None = None[m
[31m-    motor: str | None = None[m
[31m-    pieza: str | None = None[m
[31m-    posicion: str | None = None[m
[31m-    codigo: str | None = None[m
[31m-    cantidad: int | None = None[m
[31m-[m
[31m-[m
[31m-@dataclass[m
[31m-class RouterOutput:[m
[31m-    intencion: str[m
[31m-    especialista: str[m
[31m-    confianza: float[m
[31m-    datos_extraidos: DatosExtraidos[m
[31m-    cuenta_como_consulta: bool[m
[31m-    razon: str[m
[31m-[m
[31m-    def to_dict(self) -> dict:[m
[31m-        d = asdict(self)[m
[31m-        return d[m
[31m-[m
[31m-[m
[31m-# ---------- Función pública ----------[m
[31m-[m
[31m-def clasificar([m
[31m-    mensaje: str,[m
[31m-    historial: list[dict] | None = None,[m
[31m-    cliente: dict | None = None,[m
[31m-    consulta_abierta: dict | None = None,[m
[31m-) -> RouterOutput:[m
[31m-    """[m
[31m-    Clasifica un mensaje del cliente.[m
[31m-[m
[31m-    Args:[m
[31m-        mensaje: el texto del cliente (post-STT si era audio).[m
[31m-        historial: lista de últimos N mensajes (cada uno {emisor, contenido}).[m
[31m-        cliente: info del cliente {nombre, vehiculo_default, etiquetas}.[m
[31m-        consulta_abierta: si hay una consulta abierta, info de ella[m
[31m-                          {intencion, datos_acumulados, ultimo_turno_bot}.[m
[31m-[m
[31m-    Returns:[m
[31m-        RouterOutput validado.[m
[31m-[m
[31m-    Raises:[m
[31m-        ValidationError: si el LLM devuelve algo que no cumple el schema.[m
[31m-                         (lo manejamos con un fallback abajo)[m
[31m-    """[m
[31m-    contexto = _armar_contexto(mensaje, historial, cliente, consulta_abierta)[m
[31m-[m
[31m-    client = anthropic.Anthropic(api_key=os.getenv("ANTHROPIC_API_KEY"))[m
[31m-    response = client.messages.create([m
[31m-        model=MODELO,[m
[31m-        max_tokens=MAX_TOKENS,[m
[31m-        temperature=TEMPERATURA,[m
[31m-        system=SYSTEM_PROMPT,[m
[31m-        messages=[{"role": "user", "content": contexto}],[m
[31m-    )[m
[31m-[m
[31m-    raw = response.content[0].text.strip()[m
[31m-    data = _parse_json_robusto(raw)[m
[31m-[m
[31m-    try:[m
[31m-        validate(instance=data, schema=SCHEMA)[m
[31m-    except ValidationError as e:[m
[31m-        # Fallback seguro: marcar como ambiguo y dejar que el orquestador[m
[31m-        # pida aclaración. Nunca tirar excepción al cliente.[m
[31m-        return _fallback_ambiguo([m
[31m-            f"router devolvió JSON inválido: {e.message[:100]}"[m
[31m-        )[m
[31m-[m
[31m-    return RouterOutput([m
[31m-        intencion=data["intencion"],[m
[31m-        especialista=data["especialista"],[m
[31m-        confianza=data["confianza"],[m
[31m-        datos_extraidos=DatosExtraidos(**data["datos_extraidos"]),[m
[31m-        cuenta_como_consulta=data["cuenta_como_consulta"],[m
[31m-        razon=data["razon"],[m
[31m-    )[m
[31m-[m
[31m-[m
[31m-# ---------- Helpers privados ----------[m
[31m-[m
[31m-def _armar_contexto([m
[31m-    mensaje: str,[m
[31m-    historial: list[dict] | None,[m
[31m-    cliente: dict | None,[m
[31m-    consulta_abierta: dict | None,[m
[31m-) -> str:[m
[31m-    partes: list[str] = [][m
[31m-[m
[31m-    if cliente:[m
[31m-        partes.append("## Cliente")[m
[31m-        partes.append(json.dumps(cliente, ensure_ascii=False, indent=2))[m
[31m-[m
[31m-    if consulta_abierta:[m
[31m-        partes.append("\n## Consulta abierta actualmente")[m
[31m-        partes.append(json.dumps(consulta_abierta, ensure_ascii=False, indent=2))[m
[31m-[m
[31m-    if historial:[m
[31m-        partes.append("\n## Últimos mensajes")[m
[31m-        for m in historial[-6:]:[m
[31m-            quien = m.get("emisor", "?")[m
[31m-            texto = m.get("contenido", "")[m
[31m-            partes.append(f"- [{quien}]: {texto}")[m
[31m-[m
[31m-    partes.append("\n## Mensaje actual a clasificar")[m
[31m-    partes.append(mensaje)[m
[31m-    partes.append("\nDevolvé SOLO el JSON, sin markdown ni explicación.")[m
[31m-[m
[31m-    return "\n".join(partes)[m
[31m-[m
[31m-[m
[31m-def _parse_json_robusto(raw: str) -> dict:[m
[31m-    """[m
[31m-    El modelo a veces envuelve la respuesta en ```json ... ``` aunque le pidamos[m
[31m-    que no lo haga. Limpiamos antes de parsear.[m
[31m-    """[m
[31m-    # Sacar bloques de código markdown si vinieron[m
[31m-    if "```" in raw:[m
[31m-        m = re.search(r"```(?:json)?\s*(.*?)\s*```", raw, re.DOTALL)[m
[31m-        if m:[m
[31m-            raw = m.group(1)[m
[31m-    # Sacar texto antes/después del JSON[m
[31m-    start = raw.find("{")[m
[31m-    end = raw.rfind("}")[m
[31m-    if start != -1 and end != -1:[m
[31m-        raw = raw[start : end + 1][m
[31m-    return json.loads(raw)[m
[31m-[m
[31m-[m
[31m-def _fallback_ambiguo(razon: str) -> RouterOutput:[m
[31m-    return RouterOutput([m
[31m-        intencion="ambiguo",[m
[31m-        especialista="ninguno",[m
[31m-        confianza=0.0,[m
[31m-        datos_extraidos=DatosExtraidos(),[m
[31m-        cuenta_como_consulta=False,[m
[31m-        razon=razon,[m
[31m-    )[m
[31m-[m
[31m-[m
[31m-# ---------- Test manual rápido ----------[m
[31m-[m
[31m-if __name__ == "__main__":[m
[31m-    # Probá con:  python -m agents.router.router[m
