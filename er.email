[1mdiff --git a/functions/_rpcs/catalog_rpcs.sql b/functions/_rpcs/catalog_rpcs.sql[m
[1mnew file mode 100644[m
[1mindex 0000000..24cc890[m
[1m--- /dev/null[m
[1m+++ b/functions/_rpcs/catalog_rpcs.sql[m
[36m@@ -0,0 +1,168 @@[m
[32m+[m[32m-- =====================================================[m
[32m+[m[32m-- catalog_rpcs.sql[m
[32m+[m[32m-- Funciones Postgres que sirven como backend de las tools[m
[32m+[m[32m-- del bot Toni. YA ESTÁN CARGADAS EN SUPABASE.[m
[32m+[m[32m-- Este archivo queda en el repo como referencia.[m
[32m+[m[32m-- =====================================================[m
[32m+[m
[32m+[m[32mCREATE OR REPLACE FUNCTION rpc_buscar_producto([m
[32m+[m[32m  p_empresa_id BIGINT,[m
[32m+[m[32m  p_query TEXT,[m
[32m+[m[32m  p_marca_pieza TEXT DEFAULT NULL,[m
[32m+[m[32m  p_linea TEXT DEFAULT NULL,[m
[32m+[m[32m  p_limit INT DEFAULT 5[m
[32m+[m[32m)[m
[32m+[m[32mRETURNS TABLE ([m
[32m+[m[32m  producto_id BIGINT,[m
[32m+[m[32m  descripcion TEXT,[m
[32m+[m[32m  marca_pieza TEXT,[m
[32m+[m[32m  linea TEXT,[m
[32m+[m[32m  stock_total BIGINT,[m
[32m+[m[32m  precio_min NUMERIC,[m
[32m+[m[32m  match_score REAL[m
[32m+[m[32m)[m
[32m+[m[32mLANGUAGE sql STABLE AS $$[m
[32m+[m[32m  SELECT p.id, p.descripcion, p.marca_pieza, p.linea,[m
[32m+[m[32m         COALESCE(SUM(o.stock), 0),[m
[32m+[m[32m         MIN(o.precio) FILTER (WHERE o.stock > 0),[m
[32m+[m[32m         ts_rank(to_tsvector('spanish', p.descripcion),[m
[32m+[m[32m                 plainto_tsquery('spanish', p_query))[m
[32m+[m[32m    FROM producto_logico p[m
[32m+[m[32m    LEFT JOIN oferta o ON o.producto_id = p.id[m
[32m+[m[32m   WHERE p.empresa_id = p_empresa_id[m
[32m+[m[32m     AND to_tsvector('spanish', p.descripcion) @@ plainto_tsquery('spanish', p_query)[m
[32m+[m[32m     AND (p_marca_pieza IS NULL OR p.marca_pieza ILIKE p_marca_pieza)[m
[32m+[m[32m     AND (p_linea IS NULL OR p.linea ILIKE p_linea)[m
[32m+[m[32m   GROUP BY p.id[m
[32m+[m[32m   ORDER BY 7 DESC, 5 DESC[m
[32m+[m[32m   LIMIT p_limit;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mCREATE OR REPLACE FUNCTION rpc_buscar_por_aplicacion([m
[32m+[m[32m  p_empresa_id BIGINT,[m
[32m+[m[32m  p_marca TEXT,[m
[32m+[m[32m  p_modelo TEXT,[m
[32m+[m[32m  p_anio INT,[m
[32m+[m[32m  p_motor TEXT DEFAULT NULL,[m
[32m+[m[32m  p_posicion TEXT DEFAULT NULL,[m
[32m+[m[32m  p_linea TEXT DEFAULT NULL,[m
[32m+[m[32m  p_limit INT DEFAULT 5[m
[32m+[m[32m)[m
[32m+[m[32mRETURNS TABLE ([m
[32m+[m[32m  producto_id BIGINT,[m
[32m+[m[32m  descripcion TEXT,[m
[32m+[m[32m  marca_pieza TEXT,[m
[32m+[m[32m  linea TEXT,[m
[32m+[m[32m  posicion TEXT,[m
[32m+[m[32m  stock_total BIGINT,[m
[32m+[m[32m  precio_min NUMERIC[m
[32m+[m[32m)[m
[32m+[m[32mLANGUAGE sql STABLE AS $$[m
[32m+[m[32m  SELECT p.id, p.descripcion, p.marca_pieza, p.linea, a.posicion,[m
[32m+[m[32m         COALESCE(SUM(o.stock), 0),[m
[32m+[m[32m         MIN(o.precio) FILTER (WHERE o.stock > 0)[m
[32m+[m[32m    FROM producto_logico p[m
[32m+[m[32m    JOIN aplicacion a ON a.producto_id = p.id[m
[32m+[m[32m    LEFT JOIN oferta o ON o.producto_id = p.id[m
[32m+[m[32m   WHERE p.empresa_id = p_empresa_id[m
[32m+[m[32m     AND a.auto_marca ILIKE p_marca[m
[32m+[m[32m     AND a.modelo ILIKE p_modelo[m
[32m+[m[32m     AND (a.anio_desde IS NULL OR a.anio_desde <= p_anio)[m
[32m+[m[32m     AND (a.anio_hasta IS NULL OR a.anio_hasta >= p_anio)[m
[32m+[m[32m     AND (p_motor IS NULL OR a.motor ILIKE '%' || p_motor || '%')[m
[32m+[m[32m     AND (p_posicion IS NULL OR a.posicion ILIKE p_posicion)[m
[32m+[m[32m     AND (p_linea IS NULL OR p.linea ILIKE p_linea)[m
[32m+[m[32m   GROUP BY p.id, a.posicion[m
[32m+[m[32m   ORDER BY 6 DESC, 7 ASC NULLS LAST[m
[32m+[m[32m   LIMIT p_limit;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mCREATE OR REPLACE FUNCTION rpc_buscar_equivalencia([m
[32m+[m[32m  p_empresa_id BIGINT,[m
[32m+[m[32m  p_codigo TEXT[m
[32m+[m[32m)[m
[32m+[m[32mRETURNS TABLE ([m
[32m+[m[32m  producto_id BIGINT,[m
[32m+[m[32m  descripcion TEXT,[m
[32m+[m[32m  marca_pieza TEXT,[m
[32m+[m[32m  tipo_equiv TEXT,[m
[32m+[m[32m  marca_externa TEXT,[m
[32m+[m[32m  confianza NUMERIC,[m
[32m+[m[32m  stock_total BIGINT,[m
[32m+[m[32m  precio_min NUMERIC[m
[32m+[m[32m)[m
[32m+[m[32mLANGUAGE sql STABLE AS $$[m
[32m+[m[32m  SELECT p.id, p.descripcion, p.marca_pieza, e.tipo, e.marca_externa, e.confianza,[m
[32m+[m[32m         COALESCE(SUM(o.stock), 0),[m
[32m+[m[32m         MIN(o.precio) FILTER (WHERE o.stock > 0)[m
[32m+[m[32m    FROM equivalencia e[m
[32m+[m[32m    JOIN producto_logico p ON p.id = e.producto_id[m
[32m+[m[32m    LEFT JOIN oferta o ON o.producto_id = p.id[m
[32m+[m[32m   WHERE p.empresa_id = p_empresa_id[m
[32m+[m[32m     AND e.codigo_externo ILIKE p_codigo[m
[32m+[m[32m   GROUP BY p.id, e.tipo, e.marca_externa, e.confianza[m
[32m+[m[32m   ORDER BY e.confianza DESC, 7 DESC;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mCREATE OR REPLACE FUNCTION rpc_consultar_precio([m
[32m+[m[32m  p_empresa_id BIGINT,[m
[32m+[m[32m  p_producto_id BIGINT[m
[32m+[m[32m)[m
[32m+[m[32mRETURNS TABLE ([m
[32m+[m[32m  producto_id BIGINT,[m
[32m+[m[32m  precio_final NUMERIC,[m
[32m+[m[32m  oferta_id BIGINT,[m
[32m+[m[32m  fuente_id BIGINT,[m
[32m+[m[32m  regla_aplicada_id BIGINT,[m
[32m+[m[32m  estrategia TEXT[m
[32m+[m[32m)[m
[32m+[m[32mLANGUAGE plpgsql STABLE AS $$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m  v_marca TEXT; v_linea TEXT; v_regla RECORD; v_oferta RECORD;[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  SELECT marca_pieza, linea INTO v_marca, v_linea[m
[32m+[m[32m    FROM producto_logico WHERE id = p_producto_id;[m
[32m+[m
[32m+[m[32m  SELECT * INTO v_regla FROM regla_precio r[m
[32m+[m[32m   WHERE r.empresa_id = p_empresa_id AND r.activa = true[m
[32m+[m[32m     AND ((r.ambito='producto' AND r.ambito_valor=p_producto_id::TEXT)[m
[32m+[m[32m       OR (r.ambito='marca' AND r.ambito_valor=v_marca)[m
[32m+[m[32m       OR (r.ambito='linea' AND r.ambito_valor=v_linea)[m
[32m+[m[32m       OR (r.ambito='global'))[m
[32m+[m[32m   ORDER BY r.prioridad DESC LIMIT 1;[m
[32m+[m
[32m+[m[32m  IF v_regla IS NULL THEN[m
[32m+[m[32m    SELECT o.id, o.precio, o.fuente_id INTO v_oferta[m
[32m+[m[32m      FROM oferta o WHERE o.producto_id=p_producto_id AND o.stock>0[m
[32m+[m[32m      ORDER BY o.precio ASC LIMIT 1;[m
[32m+[m[32m    IF v_oferta IS NULL THEN RETURN; END IF;[m
[32m+[m[32m    RETURN QUERY SELECT p_producto_id, v_oferta.precio, v_oferta.id,[m
[32m+[m[32m                        v_oferta.fuente_id, NULL::BIGINT, 'sin_regla';[m
[32m+[m[32m    RETURN;[m
[32m+[m[32m  END IF;[m
[32m+[m
[32m+[m[32m  IF v_regla.estrategia='menor_precio' THEN[m
[32m+[m[32m    SELECT o.id, o.precio, o.fuente_id INTO v_oferta FROM oferta o[m
[32m+[m[32m     WHERE o.producto_id=p_producto_id AND (NOT v_regla.requiere_stock OR o.stock>0)[m
[32m+[m[32m     ORDER BY o.precio ASC LIMIT 1;[m
[32m+[m[32m  ELSIF v_regla.estrategia='mayor_margen' THEN[m
[32m+[m[32m    SELECT o.id, o.precio, o.fuente_id INTO v_oferta FROM oferta o[m
[32m+[m[32m     WHERE o.producto_id=p_producto_id AND (NOT v_regla.requiere_stock OR o.stock>0)[m
[32m+[m[32m     ORDER BY (o.precio-COALESCE(o.costo,0)) DESC LIMIT 1;[m
[32m+[m[32m  ELSIF v_regla.estrategia='lista_fija' AND v_regla.fuente_preferida_id IS NOT NULL THEN[m
[32m+[m[32m    SELECT o.id, o.precio, o.fuente_id INTO v_oferta FROM oferta o[m
[32m+[m[32m     WHERE o.producto_id=p_producto_id AND o.fuente_id=v_regla.fuente_preferida_id[m
[32m+[m[32m       AND (NOT v_regla.requiere_stock OR o.stock>0) LIMIT 1;[m
[32m+[m[32m  END IF;[m
[32m+[m
[32m+[m[32m  IF v_oferta IS NULL THEN[m
[32m+[m[32m    SELECT o.id, o.precio, o.fuente_id INTO v_oferta FROM oferta o[m
[32m+[m[32m     WHERE o.producto_id=p_producto_id AND o.stock>0[m
[32m+[m[32m     ORDER BY o.precio ASC LIMIT 1;[m
[32m+[m[32m  END IF;[m
[32m+[m
[32m+[m[32m  IF v_oferta IS NULL THEN RETURN; END IF;[m
[32m+[m[32m  RETURN QUERY SELECT p_producto_id, v_oferta.precio, v_oferta.id,[m
[32m+[m[32m                      v_oferta.fuente_id, v_regla.id, v_regla.estrategia;[m
[32m+[m[32mEND;[m
[32m+[m[32m$$;[m
[1mdiff --git a/functions/catalog_tools.py b/functions/catalog_tools.py[m
[1mnew file mode 100644[m
[1mindex 0000000..c7c9d0e[m
[1m--- /dev/null[m
[1m+++ b/functions/catalog_tools.py[m
[36m@@ -0,0 +1,162 @@[m
[32m+[m[32m"""[m
[32m+[m[32mfunctions/catalog_tools.py[m
[32m+[m[32mLas 5 tools que el agente Producto puede invocar para responder al cliente.[m
[32m+[m[32mCada función llama a una RPC de Supabase (ya cargadas) y formatea la respuesta[m
[32m+[m[32men un dict serializable que el LLM pueda interpretar.[m
[32m+[m[32m"""[m
[32m+[m[32mfrom __future__ import annotations[m
[32m+[m
[32m+[m[32mimport os[m
[32m+[m[32mfrom typing import Optional[m
[32m+[m
[32m+[m[32mfrom functions.db import get_client[m
[32m+[m
[32m+[m
[32m+[m[32mdef buscar_producto([m
[32m+[m[32m    query: str,[m
[32m+[m[32m    marca_pieza: Optional[str] = None,[m
[32m+[m[32m    linea: Optional[str] = None,[m
[32m+[m[32m    limit: int = 5,[m
[32m+[m[32m    empresa_id: Optional[int] = None,[m
[32m+[m[32m) -> list[dict]:[m
[32m+[m[32m    """[m
[32m+[m[32m    Búsqueda full-text por descripción del producto.[m
[32m+[m
[32m+[m[32m    Args:[m
[32m+[m[32m        query: lo que el cliente busca, ej: "pastillas de freno cerámicas".[m
[32m+[m[32m        marca_pieza: filtrar por marca del fabricante (Bosch, Sachs, ...).[m
[32m+[m[32m        linea: filtrar por sistema (frenos, suspension, embrague, ...).[m
[32m+[m[32m        limit: cuántos resultados devolver (default 5).[m
[32m+[m[32m        empresa_id: si no se pasa, usa EMPRESA_ID_PILOTO del .env.[m
[32m+[m
[32m+[m[32m    Returns:[m
[32m+[m[32m        Lista de productos matching, con stock y precio mínimo si están disponibles.[m
[32m+[m[32m    """[m
[32m+[m[32m    sb = get_client()[m
[32m+[m[32m    empresa_id = empresa_id or int(os.environ.get("EMPRESA_ID_PILOTO", "1"))[m
[32m+[m
[32m+[m[32m    response = sb.rpc("rpc_buscar_producto", {[m
[32m+[m[32m        "p_empresa_id": empresa_id,[m
[32m+[m[32m        "p_query": query,[m
[32m+[m[32m        "p_marca_pieza": marca_pieza,[m
[32m+[m[32m        "p_linea": linea,[m
[32m+[m[32m        "p_limit": limit,[m
[32m+[m[32m    }).execute()[m
[32m+[m
[32m+[m[32m    return response.data or [][m
[32m+[m
[32m+[m
[32m+[m[32mdef buscar_por_aplicacion([m
[32m+[m[32m    marca: str,[m
[32m+[m[32m    modelo: str,[m
[32m+[m[32m    anio: int,[m
[32m+[m[32m    motor: Optional[str] = None,[m
[32m+[m[32m    posicion: Optional[str] = None,[m
[32m+[m[32m    linea: Optional[str] = None,[m
[32m+[m[32m    limit: int = 5,[m
[32m+[m[32m    empresa_id: Optional[int] = None,[m
[32m+[m[32m) -> list[dict]:[m
[32m+[m[32m    """[m
[32m+[m[32m    Búsqueda por vehículo: "qué tengo para un VW Gol 2010".[m
[32m+[m
[32m+[m[32m    Args:[m
[32m+[m[32m        marca: marca del auto (VW, Ford, Renault...).[m
[32m+[m[32m        modelo: modelo (Gol, Fiesta, Clio...).[m
[32m+[m[32m        anio: año del vehículo.[m
[32m+[m[32m        motor: cilindrada/version opcional (1.6, 1.4 TDI).[m
[32m+[m[32m        posicion: delantera/trasera/superior/inferior.[m
[32m+[m[32m        linea: filtrar por sistema.[m
[32m+[m[32m    """[m
[32m+[m[32m    sb = get_client()[m
[32m+[m[32m    empresa_id = empresa_id or int(os.environ.get("EMPRESA_ID_PILOTO", "1"))[m
[32m+[m
[32m+[m[32m    response = sb.rpc("rpc_buscar_por_aplicacion", {[m
[32m+[m[32m        "p_empresa_id": empresa_id,[m
[32m+[m[32m        "p_marca": marca,[m
[32m+[m[32m        "p_modelo": modelo,[m
[32m+[m[32m        "p_anio": anio,[m
[32m+[m[32m        "p_motor": motor,[m
[32m+[m[32m        "p_posicion": posicion,[m
[32m+[m[32m        "p_linea": linea,[m
[32m+[m[32m        "p_limit": limit,[m
[32m+[m[32m    }).execute()[m
[32m+[m
[32m+[m[32m    return response.data or [][m
[32m+[m
[32m+[m
[32m+[m[32mdef buscar_equivalencia([m
[32m+[m[32m    codigo: str,[m
[32m+[m[32m    empresa_id: Optional[int] = None,[m
[32m+[m[32m) -> list[dict]:[m
[32m+[m[32m    """[m
[32m+[m[32m    Buscar producto por código OEM o cruzada (ej: cliente trae el código del[m
[32m+[m[32m    fabricante original y queremos saber qué producto del catálogo lo reemplaza).[m
[32m+[m[32m    """[m
[32m+[m[32m    sb = get_client()[m
[32m+[m[32m    empresa_id = empresa_id or int(os.environ.get("EMPRESA_ID_PILOTO", "1"))[m
[32m+[m
[32m+[m[32m    response = sb.rpc("rpc_buscar_equivalencia", {[m
[32m+[m[32m        "p_empresa_id": empresa_id,[m
[32m+[m[32m        "p_codigo": codigo,[m
[32m+[m[32m    }).execute()[m
[32m+[m
[32m+[m[32m    return response.data or [][m
[32m+[m
[32m+[m
[32m+[m[32mdef consultar_precio([m
[32m+[m[32m    producto_id: int,[m
[32m+[m[32m    empresa_id: Optional[int] = None,[m
[32m+[m[32m) -> Optional[dict]:[m
[32m+[m[32m    """[m
[32m+[m[32m    Devolver el precio final aplicando las reglas configuradas[m
[32m+[m[32m    (especificidad CSS-style: producto > marca > linea > global).[m
[32m+[m[32m    """[m
[32m+[m[32m    sb = get_client()[m
[32m+[m[32m    empresa_id = empresa_id or int(os.environ.get("EMPRESA_ID_PILOTO", "1"))[m
[32m+[m
[32m+[m[32m    response = sb.rpc("rpc_consultar_precio", {[m
[32m+[m[32m        "p_empresa_id": empresa_id,[m
[32m+[m[32m        "p_producto_id": producto_id,[m
[32m+[m[32m    }).execute()[m
[32m+[m
[32m+[m[32m    if response.data:[m
[32m+[m[32m        return response.data[0][m
[32m+[m[32m    return None[m
[32m+[m
[32m+[m
[32m+[m[32mdef consultar_stock([m
[32m+[m[32m    producto_id: int,[m
[32m+[m[32m    empresa_id: Optional[int] = None,[m
[32m+[m[32m) -> dict:[m
[32m+[m[32m    """[m
[32m+[m[32m    Stock agregado por todas las fuentes para un producto.[m
[32m+[m[32m    """[m
[32m+[m[32m    sb = get_client()[m
[32m+[m[32m    empresa_id = empresa_id or int(os.environ.get("EMPRESA_ID_PILOTO", "1"))[m
[32m+[m
[32m+[m[32m    # Sumar el stock de todas las ofertas del producto[m
[32m+[m[32m    response = ([m
[32m+[m[32m        sb.table("oferta")[m
[32m+[m[32m          .select("stock, deposito, fuente_id, codigo_en_fuente")[m
[32m+[m[32m          .eq("producto_id", producto_id)[m
[32m+[m[32m          .execute()[m
[32m+[m[32m    )[m
[32m+[m[32m    ofertas = response.data or [][m
[32m+[m[32m    total = sum(o.get("stock") or 0 for o in ofertas)[m
[32m+[m
[32m+[m[32m    return {[m
[32m+[m[32m        "producto_id": producto_id,[m
[32m+[m[32m        "stock_total": total,[m
[32m+[m[32m        "ofertas": ofertas,[m
[32m+[m[32m        "hay_stock": total > 0,[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m
[32m+[m[32m# Mapa de tools para registrar en el agente[m
[32m+[m[32mTOOLS_MAP = {[m
[32m+[m[32m    "buscar_producto": buscar_producto,[m
[32m+[m[32m    "buscar_por_aplicacion": buscar_por_aplicacion,[m
[32m+[m[32m    "buscar_equivalencia": buscar_equivalencia,[m
[32m+[m[32m    "consultar_precio": consultar_precio,[m
[32m+[m[32m    "consultar_stock": consultar_stock,[m
[32m+[m[32m}[m
