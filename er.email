[31m-// ============ STATE ============[m
[31m-const STORAGE_KEY = 'toni-checklist-v1';[m
[31m-let state = loadState();[m
[31m-[m
[31m-function loadState() {[m
[31m-  try {[m
[31m-    const raw = localStorage.getItem(STORAGE_KEY);[m
[31m-    if (!raw) return {};[m
[31m-    return JSON.parse(raw);[m
