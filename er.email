[31m-  codigo_en_fuente TEXT,[m
[31m-  precio NUMERIC(12,2),[m
[31m-  costo NUMERIC(12,2),[m
[31m-  stock INT DEFAULT 0,[m
[31m-  deposito TEXT,[m
[31m-  url_origen TEXT,                              -- link al producto si la fuente es web[m
[31m-  actualizado_at TIMESTAMPTZ DEFAULT now()[m
[31m-);[m
[31m-CREATE INDEX IF NOT EXISTS idx_oferta_producto ON oferta(producto_id);[m
[31m-CREATE INDEX IF NOT EXISTS idx_oferta_codigo ON oferta(codigo_en_fuente);[m
