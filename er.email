[31m-[m
[31m-[m
[31m-# ---------- Búsqueda por texto ----------[m
[31m-[m
[31m-def buscar_producto([m
[31m-    empresa_id: int,[m
[31m-    descripcion: str,[m
[31m-    marca_pieza: str | None = None,[m
