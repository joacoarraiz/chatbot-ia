[1m--- /dev/null[m
[1m+++ b/agents/router/schema.json[m
[36m@@ -0,0 +1,35 @@[m
[32m+[m[32m{[m
[32m+[m[32m  "type": "object",[m
[32m+[m[32m  "properties": {[m
[32m+[m[32m    "agente": {[m
[32m+[m[32m      "type": "string",[m
[32m+[m[32m      "enum": ["producto", "cotizacion", "pedido", "faq", "derivacion", "ninguno"],[m
[32m+[m[32m      "description": "El agente que debería atender este mensaje. 'ninguno' para saludos/gracias."[m
[32m+[m[32m    },[m
[32m+[m[32m    "intencion": {[m
[32m+[m[32m      "type": "string",[m
[32m+[m[32m      "description": "Nombre corto de la intención detectada (ej: buscar_por_aplicacion, consultar_estado_pedido, saludar)."[m
[32m+[m[32m    },[m
[32m+[m[32m    "confianza": {[m
[32m+[m[32m      "type": "number",[m
[32m+[m[32m      "minimum": 0,[m
[32m+[m[32m      "maximum": 1,[m
[32m+[m[32m      "description": "Qué tan seguro está el router de su clasificación."[m
[32m+[m[32m    },[m
[32m+[m[32m    "razonamiento": {[m
[32m+[m[32m      "type": "string",[m
[32m+[m[32m      "description": "Breve explicación de por qué se eligió ese agente."[m
[32m+[m[32m    },[m
[32m+[m[32m    "datos": {[m
[32m+[m[32m      "type": "object",[m
[32m+[m[32m      "description": "Datos extraídos del mensaje (marca, modelo, año, código, etc). Estructura libre.",[m
[32m+[m[32m      "additionalProperties": true[m
[32m+[m[32m    },[m
[32m+[m[32m    "cuenta_como_consulta": {[m
[32m+[m[32m      "type": "boolean",[m
[32m+[m[32m      "description": "True si este mensaje inicia o continúa una consulta facturable. False para saludos sueltos."[m
[32m+[m[32m    }[m
[32m+[m[32m  },[m
[32m+[m[32m  "required": ["agente", "intencion", "confianza", "razonamiento", "datos", "cuenta_como_consulta"],[m
[32m+[m[32m  "additionalProperties": false[m
[32m+[m[32m}[m
