[32m+[m[32m# --- Credenciales (CRÍTICO: nunca subir el .env real) ---[m
[32m+[m[32m.env[m
[32m+[m[32m.env.local[m
[32m+[m[32m.env.*.local[m
[32m+[m
[32m+[m[32m# --- Entornos virtuales de Python ---[m
[32m+[m[32mvenv/[m
[32m+[m[32menv/[m
[32m+[m[32m.venv/[m
[32m+[m[32mENV/[m
[32m+[m
[32m+[m[32m# --- Cache de Python ---[m
[32m+[m[32m__pycache__/[m
[32m+[m[32m*.py[cod][m
[32m+[m[32m*$py.class[m
[32m+[m[32m*.so[m
[32m+[m[32m.Python[m
[32m+[m
[32m+[m[32m# --- Distribuciones ---[m
[32m+[m[32mbuild/[m
[32m+[m[32mdist/[m
[32m+[m[32m*.egg-info/[m
[32m+[m[32m*.egg[m
[32m+[m
[32m+[m[32m# --- VS Code y editores ---[m
[32m+[m[32m.vscode/[m
[32m+[m[32m.idea/[m
[32m+[m[32m*.swp[m
[32m+[m[32m*.swo[m
[32m+[m[32m.DS_Store[m
[32m+[m[32mThumbs.db[m
[32m+[m
[32m+[m[32m# --- Logs ---[m
[32m+[m[32m*.log[m
[32m+[m[32mlogs/[m
[32m+[m
[32m+[m[32m# --- Datos sensibles del piloto ---[m
[32m+[m[32m# (si en algún momento bajamos un dump local)[m
[32m+[m[32m*.csv.local[m
[32m+[m[32mcatalog_dumps/[m
