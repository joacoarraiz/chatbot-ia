[31m-  contenido TEXT,[m
[31m-  tipo_media TEXT,                         -- 'texto'|'audio'|'imagen'|'documento'[m
[31m-  media_url TEXT,[m
[31m-  metadata JSONB,                          -- tokens usados, latencia, etc.[m
[31m-  creado_at TIMESTAMPTZ DEFAULT now()[m
[31m-);[m
[31m-CREATE INDEX idx_msg_conv ON mensaje(conversacion_id, creado_at);[m
[31m-CREATE INDEX idx_msg_consulta ON mensaje(consulta_id);[m
[31m-[m
[31m--- ★ La unidad de facturación[m
[31m-CREATE TABLE consulta ([m
[31m-  id BIGSERIAL PRIMARY KEY,[m
[31m-  empresa_id BIGINT REFERENCES empresa ON DELETE CASCADE,[m
[31m-  conversacion_id BIGINT REFERENCES conversacion,[m
[31m-  cliente_id BIGINT REFERENCES cliente,[m
[31m-  intencion TEXT NOT NULL,                 -- 'buscar_producto'|'estado_pedido'|'faq'|'humano'|'cotizacion'[m
[31m-  estado TEXT DEFAULT 'abierta',           -- 'abierta'|'resuelta'|'derivada'|'abandonada'[m
[31m-  resultado TEXT,                          -- 'venta'|'cotizacion'|'derivacion'|'sin_resultado'[m
[31m-  productos_consultados BIGINT[],[m
[31m-  monto_cotizado NUMERIC(12,2),[m
[31m-  iniciada_at TIMESTAMPTZ DEFAULT now(),[m
[31m-  cerrada_at TIMESTAMPTZ,[m
[31m-  -- Métrica de costo[m
[31m-  tokens_usados INT DEFAULT 0,[m
[31m-  costo_ia_usd NUMERIC(8,4) DEFAULT 0[m
[31m-);[m
[31m-CREATE INDEX idx_consulta_empresa_mes ON consulta(empresa_id, iniciada_at);[m
[31m-CREATE INDEX idx_consulta_cliente ON consulta(cliente_id);[m
[31m-[m
[31m--- Log del router: qué intent detectó, con qué confianza[m
[31m-CREATE TABLE intencion_log ([m
[31m-  id BIGSERIAL PRIMARY KEY,[m
[31m-  mensaje_id BIGINT REFERENCES mensaje,[m
[31m-  intencion_detectada TEXT,[m
[31m-  confianza NUMERIC(3,2),[m
[31m-  agente_asignado TEXT,[m
[31m-  datos_extraidos JSONB[m
[31m-);[m
[31m-```[m
[31m-[m
[31m-### Bloque D — Pedidos, derivaciones y scoring[m
[31m-[m
[31m-```sql[m
[31m-CREATE TABLE pedido ([m
