[1m--- /dev/null[m
[1m+++ b/docs/GUIA_SUPABASE.md[m
[36m@@ -0,0 +1,33 @@[m
[32m+[m[32m# Guía rápida — Supabase[m
[32m+[m
[32m+[m[32m## Acceso al panel[m
[32m+[m
[32m+[m[32mAndá a https://supabase.com y entrá a tu proyecto "Toni chatbot".[m
[32m+[m
[32m+[m[32m## Cosas útiles desde el panel[m
[32m+[m
[32m+[m[32m- **Table Editor**: ver y editar filas a mano.[m
[32m+[m[32m- **SQL Editor**: correr queries SQL.[m
[32m+[m[32m- **Database → Functions**: ver las RPC creadas.[m
[32m+[m[32m- **Storage**: el bucket `media` (audios e imágenes).[m
[32m+[m[32m- **Project Settings → API**: las credenciales (URL, anon key, service_role key).[m
[32m+[m
[32m+[m[32m## RPC ya cargadas (ver functions/_rpcs/catalog_rpcs.sql)[m
[32m+[m
[32m+[m[32m- `rpc_buscar_producto(empresa_id, query, marca_pieza, linea, limit)`[m
[32m+[m[32m- `rpc_buscar_por_aplicacion(empresa_id, marca, modelo, anio, motor, posicion, linea, limit)`[m
[32m+[m[32m- `rpc_buscar_equivalencia(empresa_id, codigo)`[m
[32m+[m[32m- `rpc_consultar_precio(empresa_id, producto_id)`[m
[32m+[m
[32m+[m[32m## Cómo verificar que la base está sana[m
[32m+[m
[32m+[m[32m```sql[m
[32m+[m[32m-- Contar lo que hay en cada tabla[m
[32m+[m[32mSELECT 'producto_logico' AS tabla, COUNT(*) FROM producto_logico[m
[32m+[m[32mUNION ALL SELECT 'oferta', COUNT(*) FROM oferta[m
[32m+[m[32mUNION ALL SELECT 'aplicacion', COUNT(*) FROM aplicacion[m
[32m+[m[32mUNION ALL SELECT 'empresa', COUNT(*) FROM empresa;[m
[32m+[m
[32m+[m[32m-- Test de búsqueda[m
[32m+[m[32mSELECT * FROM rpc_buscar_por_aplicacion(1, 'VW', 'Gol', 2010, NULL, NULL, NULL, 5);[m
[32m+[m[32m```[m
