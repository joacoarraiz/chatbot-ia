[31m-        db = get_client()[m
[31m-        result = db.rpc([m
[31m-            "rpc_buscar_equivalencia",[m
[31m-            {"p_empresa_id": empresa_id, "p_codigo": codigo_externo},[m
[31m-        ).execute()[m
[31m-        return {"resultados": result.data or []}[m
[31m-    except Exception as e:[m
[31m-        return {"error": f"buscar_equivalencia falló: {str(e)[:200]}"}[m
[31m-[m
[31m-[m
[31m-# ---------- Stock ----------[m
[31m-[m
[31m-def consultar_stock(producto_id: int) -> dict:[m
[31m-    try:[m
[31m-        db = get_client()[m
[31m-        result = ([m
[31m-            db.table("oferta")[m
[31m-              .select("fuente_id, codigo_en_fuente, stock, deposito")[m
[31m-              .eq("producto_id", producto_id)[m
[31m-              .gt("stock", 0)[m
[31m-              .execute()[m
[31m-        )[m
[31m-        ofertas = result.data or [][m
[31m-        total = sum(o["stock"] for o in ofertas)[m
[31m-        return {[m
[31m-            "producto_id": producto_id,[m
[31m-            "stock_total": total,[m
[31m-            "ofertas": ofertas,[m
[31m-        }[m
[31m-    except Exception as e:[m
[31m-        return {"error": f"consultar_stock falló: {str(e)[:200]}"}[m
[31m-[m
[31m-[m
[31m-# ---------- Precio (con reglas) ----------[m
