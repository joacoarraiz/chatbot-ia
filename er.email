[32m+[m[32m"""[m
[32m+[m[32mfunctions/order_tools.py[m
[32m+[m[32mTools que usan los agentes Cotización, Pedido y Derivación.[m
[32m+[m[32m"""[m
[32m+[m[32mfrom __future__ import annotations[m
[32m+[m
[32m+[m[32mimport os[m
[32m+[m[32mfrom typing import Optional[m
[32m+[m
[32m+[m[32mfrom functions.db import get_client[m
[32m+[m
[32m+[m
[32m+[m[32mdef armar_pedido([m
[32m+[m[32m    cliente_id: int,[m
[32m+[m[32m    items: list[dict],[m
[32m+[m[32m    consulta_id: Optional[int] = None,[m
[32m+[m[32m    empresa_id: Optional[int] = None,[m
[32m+[m[32m) -> dict:[m
[32m+[m[32m    """[m
[32m+[m[32m    Crea un pedido en estado 'borrador' con los items que el cliente quiere.[m
[32m+[m
[32m+[m[32m    Args:[m
[32m+[m[32m        cliente_id: cliente que pide.[m
[32m+[m[32m        items: lista de {producto_id, cantidad, precio_unitario}.[m
[32m+[m[32m        consulta_id: la consulta de la que salió el pedido (opcional).[m
[32m+[m[32m    """[m
[32m+[m[32m    sb = get_client()[m
[32m+[m[32m    empresa_id = empresa_id or int(os.environ.get("EMPRESA_ID_PILOTO", "1"))[m
[32m+[m
[32m+[m[32m    total = sum(i["cantidad"] * i["precio_unitario"] for i in items)[m
[32m+[m
[32m+[m[32m    pedido = sb.table("pedido").insert({[m
[32m+[m[32m        "empresa_id": empresa_id,[m
[32m+[m[32m        "cliente_id": cliente_id,[m
[32m+[m[32m        "consulta_id": consulta_id,[m
[32m+[m[32m        "total": total,[m
[32m+[m[32m        "estado": "borrador",[m
[32m+[m[32m    }).execute()[m
[32m+[m
[32m+[m[32m    pedido_id = pedido.data[0]["id"][m
[32m+[m
[32m+[m[32m    items_data = [{[m
[32m+[m[32m        "pedido_id": pedido_id,[m
[32m+[m[32m        "producto_id": i["producto_id"],[m
[32m+[m[32m        "cantidad": i["cantidad"],[m
[32m+[m[32m        "precio_unitario": i["precio_unitario"],[m
[32m+[m[32m    } for i in items][m
[32m+[m
[32m+[m[32m    sb.table("pedido_item").insert(items_data).execute()[m
[32m+[m
[32m+[m[32m    return {"pedido_id": pedido_id, "total": total, "items": len(items)}[m
[32m+[m
[32m+[m
[32m+[m[32mdef consultar_pedido([m
[32m+[m[32m    pedido_id: int,[m
[32m+[m[32m    empresa_id: Optional[int] = None,[m
[32m+[m[32m) -> Optional[dict]:[m
[32m+[m[32m    """Estado actual de un pedido."""[m
[32m+[m[32m    sb = get_client()[m
[32m+[m[32m    empresa_id = empresa_id or int(os.environ.get("EMPRESA_ID_PILOTO", "1"))[m
[32m+[m
[32m+[m[32m    pedido = ([m
[32m+[m[32m        sb.table("pedido")[m
[32m+[m[32m          .select("*, pedido_item(*)")[m
[32m+[m[32m          .eq("id", pedido_id)[m
[32m+[m[32m          .eq("empresa_id", empresa_id)[m
[32m+[m[32m          .single()[m
[32m+[m[32m          .execute()[m
[32m+[m[32m    )[m
[32m+[m[32m    return pedido.data[m
[32m+[m
[32m+[m
[32m+[m[32mdef derivar_humano([m
[32m+[m[32m    consulta_id: int,[m
[32m+[m[32m    motivo: str,[m
[32m+[m[32m    resumen_contexto: str,[m
[32m+[m[32m    valor_cotizado: Optional[float] = None,[m
[32m+[m[32m) -> dict:[m
[32m+[m[32m    """[m
[32m+[m[32m    Crear una derivación para que un humano retome la conversación.[m
[32m+[m[32m    El resumen_contexto es CRÍTICO porque el vendedor lo lee antes[m
[32m+[m[32m    de tomar la conversación.[m
[32m+[m[32m    """[m
[32m+[m[32m    sb = get_client()[m
[32m+[m
[32m+[m[32m    derivacion = sb.table("derivacion").insert({[m
[32m+[m[32m        "consulta_id": consulta_id,[m
[32m+[m[32m        "motivo": motivo,[m
[32m+[m[32m        "resumen_contexto": resumen_contexto,[m
[32m+[m[32m        "valor_cotizado": valor_cotizado,[m
[32m+[m[32m        "estado": "pendiente",[m
[32m+[m[32m    }).execute()[m
[32m+[m
[32m+[m[32m    return {"derivacion_id": derivacion.data[0]["id"], "estado": "pendiente"}[m
[32m+[m
[32m+[m
[32m+[m[32mTOOLS_MAP = {[m
[32m+[m[32m    "armar_pedido": armar_pedido,[m
[32m+[m[32m    "consultar_pedido": consultar_pedido,[m
[32m+[m[32m    "derivar_humano": derivar_humano,[m
[32m+[m[32m}[m
