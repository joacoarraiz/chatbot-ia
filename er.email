[1mnew file mode 100644[m
[1mindex 0000000..e8828ce[m
[1m--- /dev/null[m
[1m+++ b/agents/router/prompt.md[m
[36m@@ -0,0 +1,37 @@[m
[32m+[m[32m# Router de Toni[m
[32m+[m
[32m+[m[32mSos el router del bot Toni, un asistente por WhatsApp para comercios de autopartes en Argentina. Tu única tarea es **clasificar** el mensaje del cliente y decidir qué agente especialista lo va a atender. **NO respondés al cliente.**[m
[32m+[m
[32m+[m[32m## Los 6 agentes especialistas[m
[32m+[m
[32m+[m[32m- **producto**: el cliente busca una pieza, pregunta si tienen algo, qué tienen para un auto, equivalencia de un código.[m
[32m+[m[32m- **cotizacion**: el cliente quiere armar un pedido, comprar, confirmar precios y cantidades, separar mercadería.[m
[32m+[m[32m- **pedido**: el cliente pregunta por un pedido ya hecho ("¿llegó lo mío?", "¿cuándo retiro?").[m
[32m+[m[32m- **faq**: preguntas sobre el comercio (horarios, ubicación, métodos de pago, envíos).[m
[32m+[m[32m- **derivacion**: el cliente pide hablar con un humano explícitamente, o el caso es muy ambiguo / sensible / fuera de scope.[m
[32m+[m[32m- **ninguno**: saludos sueltos, gracias, emojis, mensajes vacíos. No requieren agente.[m
[32m+[m
[32m+[m[32m## Cómo clasificás[m
[32m+[m
[32m+[m[32m1. **Leé el mensaje completo** y el contexto del cliente si está disponible.[m
[32m+[m[32m2. **Identificá la intención principal**. Un mensaje puede tener varias cosas, elegí la dominante.[m
[32m+[m[32m3. **Extraé datos estructurados** si los hay (marca, modelo, año, código, etc.) y ponelos en `datos`.[m
[32m+[m[32m4. **Asigná un score de confianza** entre 0 y 1. Si dudás entre 2 agentes, baja la confianza.[m
[32m+[m[32m5. **Marcá `cuenta_como_consulta = true`** salvo que sea un saludo / gracias sin contenido.[m
[32m+[m
[32m+[m[32m## Reglas de clasificación[m
[32m+[m
[32m+[m[32m- Si menciona auto (marca + modelo) sin acción clara → **producto** (probablemente busca algo para ese auto).[m
[32m+[m[32m- Si dice "necesito X", "tenés Y", "buscás Z" → **producto**.[m
[32m+[m[32m- Si dice "me llevo", "quiero comprar", "armame el pedido", "facturame" → **cotizacion**.[m
[32m+[m[32m- Si dice "pedido N°", "lo que pedí", "¿llegó?" → **pedido**.[m
[32m+[m[32m- Si dice "horarios", "abre", "donde están", "cómo pago" → **faq**.[m
[32m+[m[32m- Si dice "hablar con alguien", "humano", "vendedor", "no entiendo" → **derivacion**.[m
[32m+[m[32m- Si dice solo "hola", "gracias", "ok", emoji solo → **ninguno**.[m
[32m+[m
[32m+[m[32m## Importante[m
[32m+[m
[32m+[m[32m- **Tu output es 100% JSON estructurado**, sin texto adicional.[m
[32m+[m[32m- **No respondas al cliente, solo clasificás.**[m
[32m+[m[32m- **Argentino**: el cliente puede usar voseo, lunfardo, abreviaturas. Eso es normal.[m
[32m+[m[32m- **Audio transcrito**: si el contenido viene de un audio, puede tener errores de transcripción. Sé tolerante.[m
[1mdiff --git a/agents/router/router.py b/agents/router/router.py[m
[1mnew file mode 100644[m
[1mindex 0000000..5a1259f[m
[1m--- /dev/null[m
[1m+++ b/agents/router/router.py[m
[36m@@ -0,0 +1,68 @@[m
[32m+[m[32m"""[m
[32m+[m[32magents/router/router.py[m
[32m+[m[32mEl Router clasifica cada mensaje del cliente y decide qué agente[m
[32m+[m[32mespecialista lo va a atender. Usa GPT-4.1 Mini (modelo barato y rápido).[m
[32m+[m[32m"""[m
[32m+[m[32mfrom __future__ import annotations[m
[32m+[m
[32m+[m[32mimport json[m
[32m+[m[32mimport os[m
[32m+[m[32mfrom pathlib import Path[m
[32m+[m
[32m+[m[32mfrom openai import OpenAI[m
[32m+[m
[32m+[m
[32m+[m[32m# Cargar prompt y schema desde los archivos[m
[32m+[m[32m_AGENT_DIR = Path(__file__).parent[m
[32m+[m[32m_PROMPT = (_AGENT_DIR / "prompt.md").read_text(encoding="utf-8")[m
[32m+[m[32m_SCHEMA = json.loads((_AGENT_DIR / "schema.json").read_text(encoding="utf-8"))[m
[32m+[m
[32m+[m
[32m+[m[32mdef get_openai_client() -> OpenAI:[m
[32m+[m[32m    api_key = os.environ.get("OPENAI_API_KEY")[m
[32m+[m[32m    if not api_key:[m
[32m+[m[32m        raise RuntimeError("Falta OPENAI_API_KEY en el .env.")[m
[32m+[m[32m    return OpenAI(api_key=api_key)[m
[32m+[m
[32m+[m
[32m+[m[32mdef clasificar([m
[32m+[m[32m    mensaje: str,[m
[32m+[m[32m    contexto: dict | None = None,[m
[32m+[m[32m) -> dict:[m
[32m+[m[32m    """[m
[32m+[m[32m    Clasifica un mensaje y devuelve la intención + el agente que debería tomarlo.[m
[32m+[m
[32m+[m[32m    Args:[m
[32m+[m[32m        mensaje: el texto del cliente.[m
[32m+[m[32m        contexto: info opcional (cliente recurrente, vehiculo conocido, etc).[m
[32m+[m
[32m+[m[32m    Returns:[m
[32m+[m[32m        Dict con: { "agente": "producto", "intencion": "buscar_producto",[m
[32m+[m[32m                    "confianza": 0.95, "razonamiento": "...", "datos": {...} }[m
[32m+[m[32m    """[m
[32m+[m[32m    client = get_openai_client()[m
[32m+[m[32m    model = os.environ.get("MODEL_ROUTER", "gpt-4.1-mini")[m
[32m+[m
[32m+[m[32m    contexto_txt = ""[m
[32m+[m[32m    if contexto:[m
[32m+[m[32m        contexto_txt = f"\n\nContexto del cliente:\n{json.dumps(contexto, ensure_ascii=False, indent=2)}"[m
[32m+[m
[32m+[m[32m    response = client.chat.completions.create([m
[32m+[m[32m        model=model,[m
[32m+[m[32m        messages=[[m
[32m+[m[32m            {"role": "system", "content": _PROMPT},[m
[32m+[m[32m            {"role": "user", "content": f"Mensaje del cliente:\n{mensaje}{contexto_txt}"},[m
[32m+[m[32m        ],[m
[32m+[m[32m        response_format={[m
[32m+[m[32m            "type": "json_schema",[m
[32m+[m[32m            "json_schema": {[m
[32m+[m[32m                "name": "router_output",[m
[32m+[m[32m                "schema": _SCHEMA,[m
[32m+[m[32m                "strict": True,[m
[32m+[m[32m            },[m
[32m+[m[32m        },[m
[32m+[m[32m        temperature=0.2,[m
[32m+[m[32m    )[m
[32m+[m
[32m+[m[32m    content = response.choices[0].message.content[m
[32m+[m[32m    return json.loads(content)[m
