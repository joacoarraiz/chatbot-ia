[32m+[m
[32m+[m[32m  .item-body { flex: 1; min-width: 0; }[m
[32m+[m[32m  .item-label {[m
[32m+[m[32m    font-size: 14px; line-height: 1.5; cursor: pointer;[m
[32m+[m[32m    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;[m
[32m+[m[32m  }[m
[32m+[m[32m  .item.done .item-label > span:first-child {[m
[32m+[m[32m    color: var(--steel); text-decoration: line-through; text-decoration-color: var(--line-2);[m
[32m+[m[32m  }[m
[32m+[m[32m  .item-hint { font-size: 12.5px; color: var(--steel); margin-top: 3px; line-height: 1.4; }[m
[32m+[m[32m  .item-hint code {[m
[32m+[m[32m    font-family: ui-monospace, 'SF Mono', Menlo, monospace;[m
[32m+[m[32m    font-size: 11.5px;[m
[32m+[m[32m    background: var(--cream-2); padding: 1px 6px; border-radius: 4px;[m
[32m+[m[32m    color: var(--accent);[m
[32m+[m[32m  }[m
[32m+[m[32m  .item-hint a { color: var(--accent); text-decoration: underline; text-decoration-color: var(--line-2); }[m
[32m+[m[32m  .item-hint a:hover { text-decoration-color: var(--accent); }[m
[32m+[m
[32m+[m[32m  .item-actions { display: flex; gap: 6px; align-items: center; flex-shrink: 0; }[m
[32m+[m[32m  .pill {[m
[32m+[m[32m    font-size: 10.5px; font-weight: 600; letter-spacing: 0.4px;[m
[32m+[m[32m    text-transform: uppercase;[m
[32m+[m[32m    padding: 3px 9px; border-radius: 999px;[m
[32m+[m[32m    border: 1px solid;[m
[32m+[m[32m    white-space: nowrap;[m
[32m+[m[32m  }[m
[32m+[m[32m  .pill.todo { background: var(--cream-2); color: var(--steel-2); border-color: var(--line-2); }[m
[32m+[m[32m  .pill.done { background: var(--green-bg); color: var(--green); border-color: #c8dfb6; }[m
[32m+[m[32m  .pill.blocked { background: var(--red-bg); color: var(--red); border-color: #e8c5c0; }[m
[32m+[m[32m  .pill.tip { background: #e7eef7; color: var(--accent); border-color: #c9d6e8; }[m
[32m+[m[32m  .pill.now { background: var(--amber-bg); color: var(--amber); border-color: #e8c688; }[m
[32m+[m
[32m+[m[32m  .icon-btn {[m
[32m+[m[32m    background: none; border: none; cursor: pointer;[m
[32m+[m[32m    color: var(--steel); font-size: 13px; padding: 4px 6px;[m
[32m+[m[32m    border-radius: 4px;[m
[32m+[m[32m  }[m
[32m+[m[32m  .icon-btn:hover { background: var(--cream-2); color: var(--accent); }[m
[32m+[m
[32m+[m[32m  .note-area {[m
[32m+[m[32m    display: none;[m
[32m+[m[32m    margin-top: 8px;[m
[32m+[m[32m    background: #fbf8f0;[m
[32m+[m[32m    border: 1px solid var(--line);[m
[32m+[m[32m    border-radius: 8px;[m
[32m+[m[32m    padding: 10px 12px;[m
[32m+[m[32m  }[m
[32m+[m[32m  .note-area.open { display: block; }[m
[32m+[m[32m  .note-area textarea {[m
[32m+[m[32m    width: 100%; border: none; background: transparent;[m
[32m+[m[32m    resize: vertical; min-height: 50px; outline: none;[m
[32m+[m[32m    font-family: var(--body); font-size: 13px; color: var(--ink);[m
[32m+[m[32m    line-height: 1.5;[m
[32m+[m[32m  }[m
[32m+[m[32m  .note-foot { font-size: 11px; color: var(--steel); margin-top: 6px; display: flex; justify-content: space-between; }[m
[32m+[m[32m  .done-date { font-size: 11.5px; color: var(--green); font-weight: 500; }[m
[32m+[m
[32m+[m[32m  /* ---------- RESPONSIVE ---------- */[m
[32m+[m[32m  @media (max-width: 640px) {[m
[32m+[m[32m    body { padding: 16px 12px; }[m
[32m+[m[32m    header { padding: 20px; }[m
[32m+[m[32m    h1 { font-size: 28px; }[m
[32m+[m[32m    .sec-head { padding: 14px 16px; }[m
[32m+[m[32m    .item { padding: 10px 16px; }[m
[32m+[m[32m    .sec-meta { gap: 8px; }[m
[32m+[m[32m    .item-actions { flex-wrap: wrap; }[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  /* ---------- PRINT ---------- */[m
[32m+[m[32m  @media print {[m
[32m+[m[32m    body { background: white; padding: 0; }[m
[32m+[m[32m    header { border: none; box-shadow: none; padding: 0 0 20px; }[m
[32m+[m[32m    .h-actions, .icon-btn { display: none; }[m
[32m+[m[32m    .section { break-inside: avoid; border-color: #ccc; }[m
[32m+[m[32m    .section { display: block !important; }[m
[32m+[m[32m    .sec-body { display: block !important; }[m
[32m+[m[32m    .note-area { display: block !important; }[m
[32m+[m[32m  }[m
[32m+[m[32m</style>[m
[32m+[m[32m</head>[m
[32m+[m[32m<body>[m
[32m+[m[32m<div class="container">[m
[32m+[m
[32m+[m[32m  <!-- ============ HEADER ============ -->[m
[32m+[m[32m  <header>[m
[32m+[m[32m    <div class="h-top">[m
[32m+[m[32m      <div>[m
[32m+[m[32m        <h1>Toni · Checklist v2</h1>[m
[32m+[m[32m        <div class="sub">Estado actualizado al 3 de junio de 2026. Lo hecho aparece pre-tachado. Tu progreso se guarda en este navegador.</div>[m
[32m+[m[32m        <div class="saved" id="savedIndicator">Guardado</div>[m
[32m+[m[32m      </div>[m
[32m+[m[32m      <div class="h-actions">[m
[32m+[m[32m        <button class="btn" onclick="expandAll()">Expandir todo</button>[m
[32m+[m[32m        <button class="btn" onclick="collapseAll()">Cerrar todo</button>[m
[32m+[m[32m        <button class="btn" onclick="exportData()">Exportar progreso</button>[m
[32m+[m[32m        <button class="btn danger" onclick="resetAll()">Resetear</button>[m
[32m+[m[32m      </div>[m
[32m+[m[32m    </div>[m
[32m+[m[32m    <div class="pgwrap">[m
[32m+[m[32m      <div class="pglabel"><span>Progreso total</span><b id="globalPct">0%</b></div>[m
[32m+[m[32m      <div class="pgbar"><div class="pgfill" id="globalFill" style="width:0%"></div></div>[m
[32m+[m[32m    </div>[m
[32m+[m[32m  </header>[m
[32m+[m
[32m+[m[32m  <div class="infobox warning">[m
[32m+[m[32m    <div class="infobox-icon">⏳</div>[m
[32m+[m[32m    <div>[m
[32m+[m[32m      <h3>Lo más urgente ahora mismo</h3>[m
[32m+[m[32m      <p>Iniciar la <b>certificación de Toni como Tech Provider en Meta</b> y completar la <b>importación del catálogo</b>. La certificación tarda hasta 25 días entre verificación de empresa y App Review — cada día que se atrasa es un día menos del calendario de lanzamiento.</p>[m
[32m+[m[32m    </div>[m
[32m+[m[32m  </div>[m
[32m+[m
[32m+[m[32m  <!-- ============ SECCIONES ============ -->[m
[32m+[m[32m  <div id="sections"></div>[m
[32m+[m
[32m+[m[32m</div>[m
[32m+[m
[32m+[m[32m<script>[m
[32m+[m[32m// ============ DATA ============[m
[32m+[m[32m// preDone:true → arranca tachado (lo que ya hicimos)[m
[32m+[m[32m// preDone se respeta solo si el usuario nunca interactuó con el ítem.[m
[32m+[m[32mconst SECTIONS = [[m
[32m+[m[32m  {[m
[32m+[m[32m    id: 'diseno',[m
[32m+[m[32m    title: 'Diseño técnico',[m
[32m+[m[32m    desc: 'Definiciones cerradas en reunión: qué es una consulta, identidad del cliente, base de datos, agentes y scoring.',[m
[32m+[m[32m    items: [[m
[32m+[m[32m      { id:'d1', label:'Aprobar el diseño técnico Etapa 1', hint:'Documento Diseno_Tecnico_Etapa1.md presentado y aprobado por el equipo.', preDone:true, doneAt:'2026-05-22' },[m
[32m+[m[32m      { id:'d2', label:'Definir nombre del producto', hint:'Quedó "Toni". Cualquier cambio implica actualizar persona_config en la base.', preDone:true, doneAt:'2026-05-22' },[m
[32m+[m[32m      { id:'d3', label:'Definir qué es una consulta', hint:'Ventana de 30 min, agrupa mensajes de una misma intención. Saludos y gracias no cuentan.', preDone:true, doneAt:'2026-05-22' },[m
[32m+[m[32m      { id:'d4', label:'Definir cómo identificamos al cliente recurrente', hint:'Tres tablas: cliente, contact_channel, vehiculo_cliente. Job nocturno calcula etiquetas (recurrente, B2B, dormido).', preDone:true, doneAt:'2026-05-22' },[m
[32m+[m[32m      { id:'d5', label:'Definir el esquema completo de base de datos', hint:'17 tablas en 4 bloques: catálogo, clientes, conversaciones, pedidos y scoring.', preDone:true, doneAt:'2026-05-22' },[m
[32m+[m[32m      { id:'d6', label:'Definir arquitectura de agentes', hint:'Router + 6 especialistas: Producto, Cotización, Pedido, FAQ, Derivación, Auditor.', preDone:true, doneAt:'2026-05-22' },[m
[32m+[m[32m      { id:'d7', label:'Definir sistema de scoring de conversaciones', hint:'5 componentes (4 determinísticos + tono evaluado por LLM auditor).', preDone:true, doneAt:'2026-05-22' },[m
[32m+[m[32m    ][m
[32m+[m[32m  },[m
[32m+[m[32m  {[m
[32m+[m[32m    id: 'github',[m
[32m+[m[32m    title: 'Repo en GitHub',[m
[32m+[m[32m    desc: 'Repo privado con todos los archivos del proyecto, subido sin Git desde el navegador.',[m
[32m+[m[32m    items: [[m
[32m+[m[32m      { id:'g1', label:'Crear cuenta de GitHub', hint:'Cuenta personal del responsable.', preDone:true, doneAt:'2026-05-30' },[m
[32m+[m[32m      { id:'g2', label:'Crear repo privado chatbot-ia', hint:'En GitHub, repo privado para mantener prompts y arquitectura propios.', preDone:true, doneAt:'2026-05-30' },[m
[32m+[m[32m      { id:'g3', label:'Subir archivos del zip al repo', hint:'Arrastrados desde el navegador, sin Git ni token.', preDone:true, doneAt:'2026-05-30' },[m
[32m+[m[32m      { id:'g4', label:'Reorganizar archivos en sus subcarpetas', hint:'Los archivos quedaron aplastados en la raíz. Mover db/, agents/, docs/ a sus carpetas correspondientes. Bajo impacto operativo pero conviene ordenarlo antes de que el equipo arranque.', tip:true },[m
[32m+[m[32m      { id:'g5', label:'Sumar a Eze, Seba y Fran como colaboradores', hint:'Settings → Collaborators → invitar por usuario de GitHub.' },[m
[32m+[m[32m    ][m
[32m+[m[32m  },[m
[32m+[m[32m  {[m
[32m+[m[32m    id: 'supabase',[m
[32m+[m[32m    title: 'Supabase — setup y base de datos',[m
[32m+[m[32m    desc: 'Proyecto creado en São Paulo. Tablas y funciones del bot listas.',[m
[32m+[m[32m    items: [[m
[32m+[m[32m      { id:'s1', label:'Crear cuenta en Supabase', hint:'Sign in con GitHub. franarraiz\'s Org.', preDone:true, doneAt:'2026-05-30' },[m
[32m+[m[32m      { id:'s2', label:'Crear proyecto Toni chatbot', hint:'Región South America (São Paulo). Project ID: gtpqmifaoameidbjazbx.', preDone:true, doneAt:'2026-05-30' },[m
[32m+[m[32m      { id:'s3', label:'Copiar URL + claves al block de notas', hint:'Project URL, anon key y service_role key. La service_role nunca se comparte por canales públicos.', preDone:true, doneAt:'2026-05-30' },[m
[32m+[m[32m      { id:'s4', label:'Invitar al equipo a la organización', hint:'Rol Administrator para Eze, Seba y Fran.', preDone:true, doneAt:'2026-05-30' },[m
[32m+[m[32m      { id:'s5', label:'Correr 01_catalog.sql', hint:'Crea empresa, fuente_catalogo, producto_logico, oferta, aplicacion, equivalencia, regla_precio.', preDone:true, doneAt:'2026-05-30' },[m
[32m+[m[32m      { id:'s6', label:'Correr 02_clients.sql', hint:'Crea cliente, contact_channel, vehiculo_cliente + función fn_get_or_create_cliente.', preDone:true, doneAt:'2026-05-30' },[m
[32m+[m[32m      { id:'s7', label:'Correr 03_conversations.sql', hint:'Crea conversacion, mensaje, consulta, intencion_log + vista v_consultas_mes_actual.', preDone:true, doneAt:'2026-05-30' },[m
[32m+[m[32m      { id:'s8', label:'Correr 04_orders_scoring.sql', hint:'Crea pedido, pedido_item, derivacion, score_consulta + vistas de salud del bot.', preDone:true, doneAt:'2026-05-30' },[m
[32m+[m[32m      { id:'s9', label:'Correr 05_rls.sql', hint:'Activa Row Level Security en todas las tablas.', preDone:true, doneAt:'2026-05-30' },[m
[32m+[m[32m      { id:'s10', label:'Crear bucket "media" en Storage', hint:'Privado. Para audios e imágenes que mande el cliente.', preDone:true, doneAt:'2026-05-30' },[m
[32m+[m[32m      { id:'s11', label:'Correr catalog_rpcs.sql (funciones de búsqueda)', hint:'Las 4 funciones rpc_*: buscar_producto, buscar_por_aplicacion, buscar_equivalencia, consultar_precio. Sin esto, el bot no puede consultar. Te pasé el contenido completo en una respuesta del chat.', tip:true },[m
[32m+[m[32m      { id:'s12', label:'Crear la primera empresa con INSERT en tabla empresa', hint:'INSERT con nombre, plan=\'basico\', persona_config. Te devuelve un id que vas a usar como empresa_id en todo lo demás.', tip:true },[m
[32m+[m[32m      { id:'s13', label:'Verificar que las 4 RPCs existen', hint:'Query de verificación: SELECT proname FROM pg_proc WHERE proname LIKE \'rpc_%\';' },[m
[32m+[m[32m    ][m
[32m+[m[32m  },[m
[32m+[m[32m  {[m
[32m+[m[32m    id: 'catalogo',[m
[32m+[m[32m    title: 'Catálogo del piloto',[m
[32m+[m[32m    desc: 'Excel real del piloto procesado (3.000 productos). Falta importar los CSV a Supabase.',[m
[32m+[m[32m    items: [[m
[32m+[m[32m      { id:'c1', label:'Recibir Excel del piloto', hint:'base_datos_Toni.xlsx con 3.000 productos en 35 marcas y 4 categorías.', preDone:true, doneAt:'2026-05-30' },[m
[32m+[m[32m      { id:'c2', label:'Auditar y analizar el Excel', hint:'Sin nulos. 75% con marca de auto identificable. 45% con año. 746 productos genéricos sin info de aplicación.', preDone:true, doneAt:'2026-05-30' },[m
[32m+[m[32m      { id:'c3', label:'Parsear descripciones → CSVs normalizados', hint:'Script Python que separa marca, modelo, año, motor, posición desde el texto libre.', preDone:true, doneAt:'2026-05-30' },[m
[32m+[m[32m      { id:'c4', label:'Generar reporte de huecos para mostrar al piloto', hint:'04_reporte.md con las 3 áreas que el piloto debe completar: precios, productos genéricos, equivalencias OEM.', preDone:true, doneAt:'2026-05-30' },[m
[32m+[m[32m      { id:'c5', label:'Correr 00_setup.sql en Supabase', hint:'Inserta la fuente_catalogo id=1 que las ofertas van a referenciar. PRIMER paso de la importación.', tip:true },[m
[32m+[m[32m      { id:'c6', label:'Importar 01_productos.csv → tabla producto_logico', hint:'Table Editor → producto_logico → Insert → Import data from CSV. 3.000 filas.' },[m
[32m+[m[32m      { id:'c7', label:'Importar 02_ofertas.csv → tabla oferta', hint:'Mismo procedimiento. 3.000 filas. Precio y stock vacíos hasta que el piloto los cargue.' },[m
[32m+[m[32m      { id:'c8', label:'Importar 03_aplicaciones.csv → tabla aplicacion', hint:'~2.597 filas (algunos productos quedaron sin aplicación detectable).' },[m
[32m+[m[32m      { id:'c9', label:'Correr 05_post_import.sql', hint:'Realinea los sequences. Sin esto, los próximos INSERT pueden chocar.' },[m
[32m+[m[32m      { id:'c10', label:'Test final: SELECT con rpc_buscar_por_aplicacion', hint:'SELECT * FROM rpc_buscar_por_aplicacion(1, \'VW\', \'Gol\', 2010, NULL, NULL, NULL, 10); Tiene que devolver productos reales.', tip:true },[m
[32m+[m[32m      { id:'c11', label:'Pedir al piloto Excel con precios y stock', hint:'Hoy no tenemos. Sin esto el bot puede recomendar pero no cotizar.' },[m
[32m+[m[32m      { id:'c12', label:'Pedir al piloto tabla de equivalencias OEM', hint:'Para que el bot encuentre cuando el cliente busca con código de fábrica.' },[m
[32m+[m[32m      { id:'c13', label:'Decidir con el piloto qué hacer con productos genéricos', hint:'746 productos sin marca de auto. Opciones: cargar info faltante, mostrar solo por código, o excluir.' },[m
[32m+[m[32m    ][m
[32m+[m[32m  },[m
[32m+[m[32m  {[m
[32m+[m[32m    id: 'meta',[m
[32m+[m[32m    title: 'Certificación en Meta como Tech Provider',[m
[32m+[m[32m    desc: 'Lo más bloqueante por tiempo. Tarda hasta 25 días entre verificación de empresa y App Review.',[m
[32m+[m[32m    items: [[m
[32m+[m[32m      { id:'m1', label:'Decidir bajo qué empresa se certifica Toni', hint:'¿La empresa donde trabajan ustedes? ¿Una nueva específica para Toni? ¿Monotributo personal? Decisión muy difícil de cambiar después.', tip:true },[m
[32m+[m[32m      { id:'m2', label:'Reunir documentación legal de la empresa', hint:'CUIT (constancia de AFIP), factura de servicios reciente, razón social, dirección legal exacta.' },[m
[32m+[m[32m      { id:'m3', label:'Publicar sitio web de Toni con URL pública', hint:'Aunque sea una landing simple. Meta lo exige y entra a verificar que cargue.' },[m
[32m+[m[32m      { id:'m4', label:'Activar 2FA en la cuenta personal de Facebook del responsable', hint:'Sin esto Meta bloquea el proceso a mitad de camino.' },[m
[32m+[m[32m      { id:'m5', label:'Etapa 1: Crear cuenta de desarrollador en Meta', hint:'developers.facebook.com → Get Started → tipo Business. 10 min.' },[m
[32m+[m[32m      { id:'m6', label:'Etapa 2: Crear app Toni con WhatsApp en Sandbox', hint:'My Apps → Create App → tipo Business → agregar producto WhatsApp. Da un número de prueba gratis.' },[m
[32m+[m[32m      { id:'m7', label:'Etapa 2: Anotar phone_number_id, WABA_id y access_token de prueba', hint:'Son las credenciales que el equipo técnico necesita para conectar el bot.' },[m
[32m+[m[32m      { id:'m8', label:'Etapa 3: Cargar info del negocio en Business Manager', hint:'Configuración del negocio → Información del negocio. Todos los campos exactos a AFIP.' },[m
[32m+[m[32m      { id:'m9', label:'Etapa 3: Iniciar verificación de empresa', hint:'Centro de seguridad → Iniciar verificación. Subir CUIT y factura. ⚠️ tarda 5-10 días hábiles.', tip:true },[m
[32m+[m[32m      { id:'m10', label:'Etapa 3: Verificación de empresa APROBADA', hint:'Llega un mail de Meta. Si piden info adicional, responder en menos de 5 días o el trámite vuelve al final de la cola.' },[m
[32m+[m[32m      { id:'m11', label:'Preparar política de privacidad publicada', hint:'URL pública en el sitio. Qué datos guardamos, por cuánto tiempo, con quién compartimos.' },[m
[32m+[m[32m      { id:'m12', label:'Preparar términos y condiciones de uso', hint:'También en URL pública.' },[m
[32m+[m[32m      { id:'m13', label:'Grabar video screencast del producto (3-5 min)', hint:'Flujo completo: comercio se conecta a Toni → cliente final manda mensaje → bot responde. Voz en off explicando.' },[m
[32m+[m[32m      { id:'m14', label:'Etapa 4: Solicitar App Review', hint:'App Review en developers.facebook.com. Pedir permisos: whatsapp_business_management, whatsapp_business_messaging, business_management.' },[m
[32m+[m[32m      { id:'m15', label:'Etapa 4: App Review APROBADA', hint:'5-15 días hábiles. Es normal pasar por una o dos rondas de feedback.' },[m
[32m+[m[32m    ][m
[32m+[m[32m  },[m
[32m+[m[32m  {[m
[32m+[m[32m    id: 'llm',[m
[32m+[m[32m    title: 'Cuentas LLM y STT',[m
[32m+[m[32m    desc: 'Decidimos arrancar con OpenAI (una sola cuenta cubre Whisper también).',[m
[32m+[m[32m    items: [[m
[32m+[m[32m      { id:'l1', label:'Comparar opciones de proveedor LLM', hint:'OpenAI vs Anthropic. Excel comparativo generado con precios actualizados y simulador de costos.', preDone:true, doneAt:'2026-06-01' },[m
[32m+[m[32m      { id:'l2', label:'Decidir proveedor LLM', hint:'Quedó OpenAI para arrancar: una sola cuenta cubre LLM + Whisper.', preDone:true, doneAt:'2026-06-01' },[m
[32m+[m[32m      { id:'l3', label:'Decidir modelo para router', hint:'GPT-4.1 Mini ($0.40 input / $1.60 output por millón de tokens).', preDone:true, doneAt:'2026-06-01' },[m
[32m+[m[32m      { id:'l4', label:'Decidir modelo para especialistas', hint:'GPT-4.1 ($5 input / $15 output). Eventualmente migrar a Claude Sonnet 4.6 si el español no convence.', preDone:true, doneAt:'2026-06-01' },[m
[32m+[m[32m      { id:'l5', label:'Decidir modelo para transcripción de audios', hint:'GPT-4o Mini Transcribe ($0.003/min).', preDone:true, doneAt:'2026-06-01' },[m
[32m+[m[32m      { id:'l6', label:'Crear cuenta en OpenAI', hint:'platform.openai.com. A veces dan crédito inicial gratis.' },[m
[32m+[m[32m      { id:'l7', label:'Generar API key', hint:'API Keys → Create new secret key. Anotar (se muestra una sola vez).' },[m
[32m+[m[32m      { id:'l8', label:'Cargar saldo inicial', hint:'USD 5-10 alcanza para arrancar con las primeras pruebas.' },[m
[32m+[m[32m      { id:'l9', label:'Configurar tope de gasto mensual', hint:'Settings → Limits. Hard limit en USD 100 para no asustarse si algo se va de mambo.' },[m
[32m+[m[32m    ][m
[32m+[m[32m  },[m
[32m+[m[32m  {[m
[32m+[m[32m    id: 'env',[m
[32m+[m[32m    title: 'Archivo .env (credenciales)',[m
[32m+[m[32m    desc: 'El archivo local con todas las claves. Nunca se sube al repo.',[m
[32m+[m[32m    items: [[m
[32m+[m[32m      { id:'e1', label:'Copiar .env.example a .env en la carpeta del proyecto', hint:'En Mac/Linux: cp .env.example .env. En Windows: click derecho → copiar y renombrar.' },[m
[32m+[m[32m      { id:'e2', label:'Completar credenciales de Supabase', hint:'SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY.' },[m
[32m+[m[32m      { id:'e3', label:'Completar OPENAI_API_KEY', hint:'La que generaste en el paso L7.' },[m
[32m+[m[32m      { id:'e4', label:'Completar credenciales de WhatsApp', hint:'WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_ACCESS_TOKEN, WHATSAPP_VERIFY_TOKEN. Sale después de la Etapa 2 de Meta.' },[m
[32m+[m[32m      { id:'e5', label:'Verificar que el .env NO está en GitHub', hint:'Buscar en el repo. Si está, hay que rotar TODAS las claves urgente.', tip:true },[m
[32m+[m[32m    ][m
[32m+[m[32m  },[m
[32m+[m[32m  {[m
[32m+[m[32m    id: 'bot-min',[m
[32m+[m[32m    title: 'Bot funcionando — versión mínima',[m
[32m+[m[32m    desc: 'El núcleo: que un mensaje entre por WhatsApp y el bot busque en el catálogo y responda.',[m
[32m+[m[32m    items: [[m
[32m+[m[32m      { id:'b1', label:'Refactorear el router a OpenAI SDK', hint:'El código del router está hecho con Anthropic SDK. Adaptarlo a OpenAI es trivial — 5 min.' },[m
[32m+[m[32m      { id:'b2', label:'Setear webhook de WhatsApp', hint:'Apuntar el webhook de Meta al endpoint del backend.' },[m
[32m+[m[32m      { id:'b3', label:'Endpoint POST /webhook que valide firma', hint:'Meta firma cada request con HMAC. Si no validás, cualquiera puede mandar mensajes falsos.' },[m
[32m+[m[32m      { id:'b4', label:'Guardar cada mensaje en tabla mensaje', hint:'Antes de cualquier procesamiento. Si algo falla, queda el log.' },[m
[32m+[m[32m      { id:'b5', label:'Crear/obtener cliente con fn_get_or_create_cliente', hint:'Función ya creada en 02_clients.sql.' },[m
[32m+[m[32m      { id:'b6', label:'Abrir/continuar conversación', hint:'Si la última está abierta y reciente (<30 min), seguir. Si no, abrir nueva.' },[m
[32m+[m[32m      { id:'b7', label:'Implementar Agente Router', hint:'Clasificador. GPT-4.1 Mini. Prompt en agents/router/prompt.md.' },[m
[32m+[m[32m      { id:'b8', label:'Implementar tool buscar_producto', hint:'Llama a rpc_buscar_producto en Postgres.' },[m
[32m+[m[32m      { id:'b9', label:'Implementar tool consultar_stock', hint:'Por producto_id → suma de stock por fuente.' },[m
[32m+[m[32m      { id:'b10', label:'Implementar tool consultar_precio', hint:'Aplica regla_precio para devolver el precio recomendado.' },[m
[32m+[m[32m      { id:'b11', label:'Implementar tool buscar_equivalencia', hint:'Por código externo → producto match.' },[m
[32m+[m[32m      { id:'b12', label:'Implementar tool buscar_por_aplicacion', hint:'Por marca + modelo + año → productos compatibles.' },[m
[32m+[m[32m      { id:'b13', label:'Implementar Agente Producto', hint:'Prompt en agents/producto/prompt.md. Conectado a sus 5 tools.' },[m
[32m+[m[32m      { id:'b14', label:'Loop: respuesta del bot → enviar a WhatsApp Cloud API', hint:'POST a Meta con el texto. Guardar wamid en mensaje.whatsapp_msg_id.' },[m
[32m+[m[32m      { id:'b15', label:'Probar end-to-end con número sandbox de Meta', hint:'Mandar "hola", "pastillas Gol 1.6 2010", verificar que responde con datos reales del catálogo cargado.' },[m
[32m+[m[32m    ][m
[32m+[m[32m  },[m
[32m+[m[32m  {[m
[32m+[m[32m    id: 'agentes',[m
[32m+[m[32m    title: 'Resto de agentes especializados',[m
[32m+[m[32m    desc: 'Una vez que Producto anda, sumamos los demás. Pueden ir en paralelo entre devs.',[m
[32m+[m[32m    items: [[m
[32m+[m[32m      { id:'a1', label:'Agente Cotización + tool armar_pedido', hint:'Cierra ventas. Crea registro en pedido y pedido_item.' },[m
[32m+[m[32m      { id:'a2', label:'Agente Pedido + tool consultar_pedido', hint:'"¿llegó mi pedido?", "¿cuándo está listo?".' },[m
[32m+[m[32m      { id:'a3', label:'Agente FAQ + tool consultar_info_empresa', hint:'Horarios, ubicación, métodos de pago.' },[m
[32m+[m[32m      { id:'a4', label:'Agente Derivación + tool derivar_humano', hint:'Crea registro en derivacion con resumen del contexto. Resumen es crítico para el vendedor.', tip:true },[m
[32m+[m[32m      { id:'a5', label:'Agente Auditor — script de scoring nocturno', hint:'Componentes 1, 2, 3 y 5 son determinísticos. Solo el de tono usa LLM.' },[m
[32m+[m[32m      { id:'a6', label:'Cron job de cierre por inactividad', hint:'Cada 5 min, llama fn_cerrar_consultas_inactivas() ya creada.' },[m
[32m+[m[32m      { id:'a7', label:'Cron job de recálculo de etiquetas de cliente', hint:'1 vez por día. Recalcula recurrente, candidato_b2b, dormido, frio.' },[m
[32m+[m[32m    ][m
[32m+[m[32m  },[m
[32m+[m[32m  {[m
[32m+[m[32m    id: 'multimodal',[m
[32m+[m[32m    title: 'Audio (Etapa 1 cierra acá)',[m
[32m+[m[32m    desc: 'Audio es clave en Argentina. Foto e imagen quedan para Etapa 2.',[m
[32m+[m[32m    items: [[m
[32m+[m[32m      { id:'mm1', label:'Detectar audio en webhook entrante', hint:'WhatsApp manda type: audio con un media_id. Hay que bajar el archivo.' },[m
[32m+[m[32m      { id:'mm2', label:'Descargar audio y guardar en Storage', hint:'Bucket "media" de Supabase.' },[m
[32m+[m[32m      { id:'mm3', label:'Llamar a GPT-4o Mini Transcribe con el audio', hint:'Pasar el archivo, recibir transcripción en español.' },[m
[32m+[m[32m      { id:'mm4', label:'Guardar transcripción en mensaje.contenido', hint:'Y la URL del audio original en media_url.' },[m
[32m+[m[32m      { id:'mm5', label:'Manejar fallas de transcripción', hint:'Si falla: "no pude escuchar el audio, ¿podés escribirlo?"' },[m
[32m+[m[32m    ][m
[32m+[m[32m  },[m
[32m+[m[32m  {[m
[32m+[m[32m    id: 'dashboard',[m
[32m+[m[32m    title: 'Dashboard y CRM',[m
[32m+[m[32m    desc: 'El front que ven los comercios y ustedes (los dueños del producto).',[m
[32m+[m[32m    items: [[m
[32m+[m[32m      { id:'p1', label:'Auth de Supabase para los comercios', hint:'Email + password. Cada uno solo ve sus datos (RLS).' },[m
[32m+[m[32m      { id:'p2', label:'Vista CRM con lista de clientes', hint:'Buscador + filtro por estado.' },[m
[32m+[m[32m      { id:'p3', label:'Ficha del cliente con historial', hint:'Drawer con timeline de mensajes, vehículos, pedidos.' },[m
[32m+[m[32m      { id:'p4', label:'Bandeja de derivaciones', hint:'Ordenada por valor cotizado × (100 - score_bot).' },[m
[32m+[m[32m      { id:'p5', label:'Dashboard del comercio', hint:'Las 4 métricas: consultas usadas / plan, salud del bot, embudo, top productos.' },[m
[32m+[m[32m      { id:'p6', label:'Vista "preguntas que el bot no supo"', hint:'Saca de score_consulta.oportunidades_mejora.' },[m
[32m+[m[32m      { id:'p7', label:'Dashboard de ustedes (dueños del producto)', hint:'Comercios activos, MRR, costo IA / consulta agregado, riesgos de churn.' },[m
[32m+[m[32m      { id:'p8', label:'Configuración: persona / tono del bot', hint:'Edita empresa.persona_config. Live preview ideal.' },[m
[32m+[m[32m      { id:'p9', label:'Configuración: fuentes de catálogo', hint:'Subir Excel, configurar Drive, gestionar el mapeo.' },[m
[32m+[m[32m    ][m
[32m+[m[32m  },[m
[32m+[m[32m  {[m
[32m+[m[32m    id: 'piloto',[m
[32m+[m[32m    title: 'Lanzamiento del piloto',[m
[32m+[m[32m    desc: 'De staging a producción con el primer comercio real (cuando Meta apruebe).',[m
[32m+[m[32m    items: [[m
[32m+[m[32m      { id:'pi1', label:'Decidir hosting del backend', hint:'Railway, Cloud Run, Render, Fly.io. Recomiendo Railway para empezar.' },[m
[32m+[m[32m      { id:'pi2', label:'Setup en producción (servidor + dominio + HTTPS)', hint:'HTTPS obligatorio para webhook de Meta.' },[m
[32m+[m[32m      { id:'pi3', label:'Apuntar webhook de producción en Meta', hint:'Reemplazar el de sandbox.' },[m
[32m+[m[32m      { id:'pi4', label:'Conectar el primer comercio piloto vía Embedded Signup', hint:'El comercio inicia sesión con su Facebook y autoriza a Toni en pocos clics.' },[m
[32m+[m[32m      { id:'pi5', label:'Pruebas internas (todo el equipo manda mensajes)', hint:'Mínimo 50 conversaciones simuladas. Revisar puntajes bajos.' },[m
[32m+[m[32m      { id:'pi6', label:'Capacitar al operador humano del piloto', hint:'Cómo usar la bandeja, cuándo retomar, cómo dar feedback al equipo técnico.' },[m
[32m+[m[32m      { id:'pi7', label:'Día 1: lanzamiento — anuncio a clientes del piloto', hint:'WhatsApp en cartelería del local, en redes, en el sitio.' },[m
[32m+[m[32m      { id:'pi8', label:'Monitoreo intensivo primera semana', hint:'Logs, errores, score promedio.' },[m
[32m+[m[32m      { id:'pi9', label:'Revisión semanal con el piloto', hint:'¿Qué le sirve? ¿Qué falta?' },[m
[32m+[m[32m      { id:'pi10', label:'Métricas a las 2 semanas', hint:'Tasa de respuesta, leads, conversiones, % auto-resueltas, costo IA real.' },[m
[32m+[m[32m    ][m
[32m+[m[32m  }[m
[32m+[m[32m];[m
[32m+[m
[32m+[m[32m// ============ STATE ============[m
[32m+[m[32mconst STORAGE_KEY = 'toni-checklist-v2';[m
[32m+[m[32mlet state = loadState();[m
[32m+[m
[32m+[m[32mfunction loadState() {[m
[32m+[m[32m  try {[m
[32m+[m[32m    const raw = localStorage.getItem(STORAGE_KEY);[m
[32m+[m[32m    if (!raw) return {};[m
[32m+[m[32m    return JSON.parse(raw);[m
[32m+[m[32m  } catch (e) { return {}; }[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction saveState() {[m
[32m+[m[32m  try {[m
[32m+[m[32m    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));[m
[32m+[m[32m    flashSaved();[m
[32m+[m[32m  } catch (e) {[m
[32m+[m[32m    console.error('No pude guardar', e);[m
[32m+[m[32m  }[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction flashSaved() {[m
[32m+[m[32m  const el = document.getElementById('savedIndicator');[m
[32m+[m[32m  el.textContent = 'Guardando…';[m
[32m+[m[32m  setTimeout(() => {[m
[32m+[m[32m    const now = new Date();[m
[32m+[m[32m    const h = String(now.getHours()).padStart(2,'0');[m
[32m+[m[32m    const m = String(now.getMinutes()).padStart(2,'0');[m
[32m+[m[32m    el.textContent = `Guardado a las ${h}:${m}`;[m
[32m+[m[32m  }, 200);[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m// Busca un item en el SECTIONS por id[m
[32m+[m[32mfunction findItemDef(itemId) {[m
[32m+[m[32m  for (const sec of SECTIONS) {[m
[32m+[m[32m    for (const it of sec.items) {[m
[32m+[m[32m      if (it.id === itemId) return it;[m
[32m+[m[32m    }[m
[32m+[m[32m  }[m
[32m+[m[32m  return null;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction getItem(itemId) {[m
[32m+[m[32m  // Si el usuario ya interactuó, respetá su estado[m
[32m+[m[32m  if (state[itemId]) return state[itemId];[m
[32m+[m[32m  // Si no, mirá el preDone del item[m
[32m+[m[32m  const def = findItemDef(itemId);[m
[32m+[m[32m  if (def && def.preDone) {[m
[32m+[m[32m    return { done: true, note: '', doneAt: def.doneAt ? new Date(def.doneAt).toISOString() : null };[m
[32m+[m[32m  }[m
[32m+[m[32m  return { done: false, note: '', doneAt: null };[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction setItem(itemId, patch) {[m
[32m+[m[32m  const current = getItem(itemId);[m
[32m+[m[32m  state[itemId] = { ...current, ...patch };[m
[32m+[m[32m  saveState();[m
[32m+[m[32m  renderProgress();[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m// ============ RENDER ============[m
[32m+[m[32mfunction render() {[m
[32m+[m[32m  const container = document.getElementById('sections');[m
[32m+[m[32m  container.innerHTML = SECTIONS.map((sec, idx) => {[m
[32m+[m[32m    const open = state['__sec_open__' + sec.id] !== false;[m
[32m+[m[32m    const allDone = sec.items.every(it => getItem(it.id).done);[m
[32m+[m[32m    return `[m
[32m+[m[32m      <div class="section ${open ? 'open' : ''} ${allDone ? 'completed' : ''}" data-sec="${sec.id}">[m
[32m+[m[32m        <div class="sec-head" onclick="toggleSection('${sec.id}')">[m
[32m+[m[32m          <div class="sec-num">${idx + 1}</div>[m
[32m+[m[32m          <div class="sec-title">[m
[32m+[m[32m            <h2>${sec.title}</h2>[m
[32m+[m[32m            <div class="desc">${sec.desc}</div>[m
[32m+[m[32m          </div>[m
[32m+[m[32m          <div class="sec-meta">[m
[32m+[m[32m            <div class="sec-pct" id="pct-${sec.id}">0%</div>[m
[32m+[m[32m            <div class="sec-chev">▼</div>[m
[32m+[m[32m          </div>[m
[32m+[m[32m        </div>[m
[32m+[m[32m        <div class="sec-body">[m
[32m+[m[32m          ${sec.items.map(it => renderItem(it)).join('')}[m
[32m+[m[32m        </div>[m
[32m+[m[32m      </div>[m
[32m+[m[32m    `;[m
[32m+[m[32m  }).join('');[m
[32m+[m[32m  renderProgress();[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction renderItem(it) {[m
[32m+[m[32m  const st = getItem(it.id);[m
[32m+[m[32m  return `[m
[32m+[m[32m    <div class="item ${st.done ? 'done' : ''}" data-item="${it.id}">[m
[32m+[m[32m      <input type="checkbox" class="cb" ${st.done ? 'checked' : ''} onchange="toggleDone('${it.id}', this.checked)">[m
[32m+[m[32m      <div class="item-body">[m
[32m+[m[32m        <label class="item-label" onclick="this.parentNode.previousElementSibling.click()">[m
[32m+[m[32m          <span>${it.label}</span>[m
[32m+[m[32m          ${it.tip ? '<span class="pill tip">Crítico</span>' : ''}[m
[32m+[m[32m        </label>[m
[32m+[m[32m        ${it.hint ? `<div class="item-hint">${it.hint}</div>` : ''}[m
[32m+[m[32m        <div class="note-area ${st.note ? 'open' : ''}" id="note-${it.id}">[m
[32m+[m[32m          <textarea[m
[32m+[m[32m            placeholder="Notas, dudas, links…"[m
[32m+[m[32m            oninput="updateNote('${it.id}', this.value)"[m
[32m+[m[32m          >${escapeHtml(st.note || '')}</textarea>[m
[32m+[m[32m          <div class="note-foot">[m
[32m+[m[32m            <span>Las notas se guardan acá nomás.</span>[m
[32m+[m[32m            ${st.doneAt ? `<span class="done-date">Hecho: ${formatDate(st.doneAt)}</span>` : ''}[m
[32m+[m[32m          </div>[m
[32m+[m[32m        </div>[m
[32m+[m[32m      </div>[m
[32m+[m[32m      <div class="item-actions">[m
[32m+[m[32m        <span class="pill ${st.done ? 'done' : 'todo'}">${st.done ? 'Hecho' : 'Pendiente'}</span>[m
[32m+[m[32m        <button class="icon-btn" onclick="toggleNote('${it.id}')" title="Notas">📝</button>[m
[32m+[m[32m      </div>[m
[32m+[m[32m    </div>[m
[32m+[m[32m  `;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction escapeHtml(s) {[m
[32m+[m[32m  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction formatDate(iso) {[m
[32m+[m[32m  const d = new Date(iso);[m
[32m+[m[32m  const dd = String(d.getDate()).padStart(2,'0');[m
[32m+[m[32m  const mm = String(d.getMonth()+1).padStart(2,'0');[m
[32m+[m[32m  return `${dd}/${mm}/${d.getFullYear()}`;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction renderProgress() {[m
[32m+[m[32m  let totalItems = 0, totalDone = 0;[m
[32m+[m[32m  SECTIONS.forEach(sec => {[m
[32m+[m[32m    let done = 0;[m
[32m+[m[32m    sec.items.forEach(it => {[m
[32m+[m[32m      totalItems++;[m
[32m+[m[32m      if (getItem(it.id).done) { done++; totalDone++; }[m
[32m+[m[32m    });[m
[32m+[m[32m    const pct = sec.items.length ? Math.round(100 * done / sec.items.length) : 0;[m
[32m+[m[32m    const el = document.getElementById(`pct-${sec.id}`);[m
[32m+[m[32m    if (el) el.textContent = `${pct}%`;[m
[32m+[m[32m    // Refrescar clase completed[m
[32m+[m[32m    const secEl = document.querySelector(`[data-sec="${sec.id}"]`);[m
[32m+[m[32m    if (secEl) {[m
[32m+[m[32m      if (done === sec.items.length) secEl.classList.add('completed');[m
[32m+[m[32m      else secEl.classList.remove('completed');[m
[32m+[m[32m    }[m
[32m+[m[32m  });[m
[32m+[m[32m  const globalPct = totalItems ? Math.round(100 * totalDone / totalItems) : 0;[m
[32m+[m[32m  document.getElementById('globalPct').textContent = `${globalPct}% (${totalDone}/${totalItems})`;[m
[32m+[m[32m  document.getElementById('globalFill').style.width = `${globalPct}%`;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m// ============ ACTIONS ============[m
[32m+[m[32mfunction toggleDone(itemId, done) {[m
[32m+[m[32m  const patch = done[m
[32m+[m[32m    ? { done: true, doneAt: new Date().toISOString() }[m
[32m+[m[32m    : { done: false, doneAt: null };[m
[32m+[m[32m  setItem(itemId, patch);[m
[32m+[m[32m  const itemEl = document.querySelector(`[data-item="${itemId}"]`);[m
[32m+[m[32m  if (itemEl) {[m
[32m+[m[32m    itemEl.classList.toggle('done', done);[m
[32m+[m[32m    const pill = itemEl.querySelector('.item-actions .pill');[m
[32m+[m[32m    if (pill && !pill.classList.contains('tip')) {[m
[32m+[m[32m      pill.className = 'pill ' + (done ? 'done' : 'todo');[m
[32m+[m[32m      pill.textContent = done ? 'Hecho' : 'Pendiente';[m
[32m+[m[32m    }[m
[32m+[m[32m    const note = itemEl.querySelector('.note-foot');[m
[32m+[m[32m    if (note) {[m
[32m+[m[32m      const st = getItem(itemId);[m
[32m+[m[32m      let dd = note.querySelector('.done-date');[m
[32m+[m[32m      if (st.doneAt) {[m
[32m+[m[32m        if (!dd) {[m
[32m+[m[32m          dd = document.createElement('span');[m
[32m+[m[32m          dd.className = 'done-date';[m
[32m+[m[32m          note.appendChild(dd);[m
[32m+[m[32m        }[m
[32m+[m[32m        dd.textContent = `Hecho: ${formatDate(st.doneAt)}`;[m
[32m+[m[32m      } else if (dd) {[m
[32m+[m[32m        dd.remove();[m
[32m+[m[32m      }[m
[32m+[m[32m    }[m
[32m+[m[32m  }[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction toggleNote(itemId) {[m
[32m+[m[32m  const el = document.getElementById('note-' + itemId);[m
[32m+[m[32m  if (el) el.classList.toggle('open');[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction updateNote(itemId, value) {[m
[32m+[m[32m  setItem(itemId, { note: value });[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction toggleSection(secId) {[m
[32m+[m[32m  const el = document.querySelector(`[data-sec="${secId}"]`);[m
[32m+[m[32m  const isOpen = el.classList.toggle('open');[m
[32m+[m[32m  state['__sec_open__' + secId] = isOpen;[m
[32m+[m[32m  saveState();[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction expandAll() {[m
[32m+[m[32m  document.querySelectorAll('.section').forEach(s => {[m
[32m+[m[32m    s.classList.add('open');[m
[32m+[m[32m    state['__sec_open__' + s.dataset.sec] = true;[m
[32m+[m[32m  });[m
[32m+[m[32m  saveState();[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction collapseAll() {[m
[32m+[m[32m  document.querySelectorAll('.section').forEach(s => {[m
[32m+[m[32m    s.classList.remove('open');[m
[32m+[m[32m    state['__sec_open__' + s.dataset.sec] = false;[m
[32m+[m[32m  });[m
[32m+[m[32m  saveState();[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction exportData() {[m
[32m+[m[32m  const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });[m
[32m+[m[32m  const url = URL.createObjectURL(blob);[m
[32m+[m[32m  const a = document.createElement('a');[m
[32m+[m[32m  const now = new Date().toISOString().slice(0,10);[m
[32m+[m[32m  a.href = url;[m
[32m+[m[32m  a.download = `toni-checklist-v2-${now}.json`;[m
[32m+[m[32m  a.click();[m
[32m+[m[32m  URL.revokeObjectURL(url);[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mfunction resetAll() {[m
[32m+[m[32m  if (!confirm('¿Borrar TODO el progreso? No se puede deshacer.')) return;[m
[32m+[m[32m  state = {};[m
[32m+[m[32m  localStorage.removeItem(STORAGE_KEY);[m
[32m+[m[32m  render();[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m// ============ INIT ============[m
[32m+[m[32mrender();[m
[32m+[m[32m</script>[m
[32m+[m[32m</body>[m
[32m+[m[32m</html>[m
