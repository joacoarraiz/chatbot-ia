[31m-  COUNT(*) FILTER (WHERE s.banda = 'regular') AS regulares,[m
[31m-  COUNT(*) FILTER (WHERE s.banda = 'mala') AS malas,[m
[31m-  ROUND(100.0 * COUNT(*) FILTER (WHERE s.banda = 'buena') / NULLIF(COUNT(s.id), 0), 1)[m
[31m-    AS pct_buenas[m
[31m-FROM empresa e[m
[31m-LEFT JOIN consulta c ON c.empresa_id = e.id[m
[31m-LEFT JOIN score_consulta s ON s.consulta_id = c.id[m
[31m-WHERE c.iniciada_at >= now() - INTERVAL '30 days'[m
[31m-GROUP BY e.id;[m
