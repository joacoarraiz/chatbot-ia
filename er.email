[31m-    """[m
[31m-    try:[m
[31m-        db = get_client()[m
[31m-        # Llamamos a una RPC creada en Supabase (ver functions/_rpcs/search_products.sql)[m
[31m-        result = db.rpc([m
[31m-            "rpc_buscar_producto",[m
[31m-            {[m
[31m-                "p_empresa_id": empresa_id,[m
[31m-                "p_query": descripcion,[m
[31m-                "p_marca_pieza": marca_pieza,[m
[31m-                "p_linea": linea,[m
