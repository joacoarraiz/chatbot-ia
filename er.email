[31m-  resuelta_at TIMESTAMPTZ[m
[31m-);[m
[31m-[m
[31m--- ★ Puntuación de cada consulta cerrada[m
[31m-CREATE TABLE score_consulta ([m
[31m-  id BIGSERIAL PRIMARY KEY,[m
[31m-  consulta_id BIGINT REFERENCES consulta ON DELETE CASCADE UNIQUE,[m
