[31m-        ).execute()[m
[31m-        return {"resultados": result.data or []}[m
[31m-    except Exception as e:[m
[31m-        return {"error": f"buscar_producto falló: {str(e)[:200]}"}[m
[31m-[m
[31m-[m
[31m-# ---------- Búsqueda por aplicación (la más usada) ----------[m
[31m-[m
[31m-def buscar_por_aplicacion([m
[31m-    empresa_id: int,[m
