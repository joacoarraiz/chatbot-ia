[1m+++ b/.env.example[m
[36m@@ -0,0 +1,38 @@[m
[32m+[m[32m# =====================================================[m
[32m+[m[32m# .env.example[m
[32m+[m[32m# Plantilla de credenciales. Copialo como .env (sin "example")[m
[32m+[m[32m# y completá los valores reales. NUNCA subir el .env al repo.[m
[32m+[m[32m# =====================================================[m
[32m+[m
[32m+[m[32m# --- Supabase (base de datos y storage) ---[m
[32m+[m[32m# Las conseguís en: Supabase > Project Settings > API[m
[32m+[m[32mSUPABASE_URL=https://TU_PROJECT_ID.supabase.co[m
[32m+[m[32mSUPABASE_ANON_KEY=eyJhbGc...[m
[32m+[m[32mSUPABASE_SERVICE_ROLE_KEY=eyJhbGc...[m
[32m+[m
[32m+[m[32m# --- OpenAI (LLM + transcripción de audios) ---[m
[32m+[m[32m# La conseguís en: platform.openai.com > API keys[m
[32m+[m[32mOPENAI_API_KEY=sk-...[m
[32m+[m
[32m+[m[32m# Modelos a usar (no cambiar a menos que sepas lo que hacés)[m
[32m+[m[32mMODEL_ROUTER=gpt-4.1-mini[m
[32m+[m[32mMODEL_SPECIALIST=gpt-4.1[m
[32m+[m[32mMODEL_TRANSCRIBE=gpt-4o-mini-transcribe[m
[32m+[m
[32m+[m[32m# --- WhatsApp Cloud API (Meta) ---[m
[32m+[m[32m# Las conseguís después de la Etapa 2 de la certificación Meta.[m
[32m+[m[32m# Mientras tanto, dejalas vacías o con valores placeholder.[m
[32m+[m[32mWHATSAPP_PHONE_NUMBER_ID=[m
[32m+[m[32mWHATSAPP_ACCESS_TOKEN=[m
[32m+[m[32mWHATSAPP_APP_SECRET=[m
[32m+[m[32mWHATSAPP_VERIFY_TOKEN=toni_verify_2026[m
[32m+[m
[32m+[m[32m# --- Empresa piloto ---[m
[32m+[m[32m# El ID de la primera empresa en la tabla `empresa` de Supabase.[m
[32m+[m[32m# Si seguiste los pasos, es 1.[m
[32m+[m[32mEMPRESA_ID_PILOTO=1[m
[32m+[m
[32m+[m[32m# --- Entorno ---[m
[32m+[m[32m# Cambia el comportamiento del bot. Opciones: development, production[m
[32m+[m[32mENV=development[m
[32m+[m[32mLOG_LEVEL=INFO[m
