[1m--- /dev/null[m
[1m+++ b/db/01_catalog.sql[m
[36m@@ -0,0 +1,101 @@[m
[32m+[m[32m-- =====================================================[m
[32m+[m[32m-- 01_catalog.sql[m
[32m+[m[32m-- Esquema del catálogo: empresas, fuentes, productos lógicos,[m
[32m+[m[32m-- ofertas concretas, aplicaciones a vehículos, equivalencias OEM[m
[32m+[m[32m-- y reglas de precio.[m
[32m+[m[32m-- =====================================================[m
[32m+[m
[32m+[m[32m-- Empresas (cada cliente de Toni es una empresa)[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS empresa ([m
[32m+[m[32m  id BIGSERIAL PRIMARY KEY,[m
[32m+[m[32m  nombre TEXT NOT NULL,[m
[32m+[m[32m  plan TEXT NOT NULL DEFAULT 'basico',[m
[32m+[m[32m  consultas_limite INT NOT NULL DEFAULT 1500,[m
[32m+[m[32m  persona_config JSONB DEFAULT '{}'::jsonb,[m
[32m+[m[32m  zona_horaria TEXT NOT NULL DEFAULT 'America/Argentina/Buenos_Aires',[m
[32m+[m[32m  estado TEXT NOT NULL DEFAULT 'activa',[m
[32m+[m[32m  creado_at TIMESTAMPTZ NOT NULL DEFAULT now()[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32m-- Fuentes de catálogo (cada empresa puede tener N fuentes: Excel, Drive, etc.)[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS fuente_catalogo ([m
[32m+[m[32m  id BIGSERIAL PRIMARY KEY,[m
[32m+[m[32m  empresa_id BIGINT NOT NULL REFERENCES empresa(id) ON DELETE CASCADE,[m
[32m+[m[32m  nombre TEXT NOT NULL,[m
[32m+[m[32m  tipo TEXT NOT NULL,[m
[32m+[m[32m  sincronizado_at TIMESTAMPTZ,[m
[32m+[m[32m  estado TEXT NOT NULL DEFAULT 'activa'[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32m-- Producto lógico (la "idea" del producto: pastilla de freno X)[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS producto_logico ([m
[32m+[m[32m  id BIGSERIAL PRIMARY KEY,[m
[32m+[m[32m  empresa_id BIGINT NOT NULL REFERENCES empresa(id) ON DELETE CASCADE,[m
[32m+[m[32m  descripcion TEXT NOT NULL,[m
[32m+[m[32m  marca_pieza TEXT,[m
[32m+[m[32m  linea TEXT,[m
[32m+[m[32m  atributos JSONB DEFAULT '{}'::jsonb,[m
[32m+[m[32m  creado_at TIMESTAMPTZ NOT NULL DEFAULT now()[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_producto_empresa ON producto_logico(empresa_id);[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_producto_descripcion_fts[m
[32m+[m[32m  ON producto_logico USING GIN (to_tsvector('spanish', descripcion));[m
[32m+[m
[32m+[m[32m-- Oferta concreta (mismo producto puede venir de distintas fuentes a distintos precios)[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS oferta ([m
[32m+[m[32m  id BIGSERIAL PRIMARY KEY,[m
[32m+[m[32m  producto_id BIGINT NOT NULL REFERENCES producto_logico(id) ON DELETE CASCADE,[m
[32m+[m[32m  fuente_id BIGINT NOT NULL REFERENCES fuente_catalogo(id) ON DELETE CASCADE,[m
[32m+[m[32m  codigo_en_fuente TEXT NOT NULL,[m
[32m+[m[32m  precio NUMERIC(12,2),[m
[32m+[m[32m  costo NUMERIC(12,2),[m
[32m+[m[32m  stock INT NOT NULL DEFAULT 0,[m
[32m+[m[32m  deposito TEXT DEFAULT 'principal',[m
[32m+[m[32m  actualizado_at TIMESTAMPTZ NOT NULL DEFAULT now()[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_oferta_producto ON oferta(producto_id);[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_oferta_codigo ON oferta(codigo_en_fuente);[m
[32m+[m
[32m+[m[32m-- Aplicación a vehículos (a qué autos sirve cada producto)[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS aplicacion ([m
[32m+[m[32m  id BIGSERIAL PRIMARY KEY,[m
[32m+[m[32m  producto_id BIGINT NOT NULL REFERENCES producto_logico(id) ON DELETE CASCADE,[m
[32m+[m[32m  auto_marca TEXT NOT NULL,[m
[32m+[m[32m  modelo TEXT NOT NULL,[m
[32m+[m[32m  anio_desde INT,[m
[32m+[m[32m  anio_hasta INT,[m
[32m+[m[32m  motor TEXT,[m
[32m+[m[32m  posicion TEXT,[m
[32m+[m[32m  notas TEXT[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_aplicacion_producto ON aplicacion(producto_id);[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_aplicacion_marca_modelo ON aplicacion(auto_marca, modelo);[m
[32m+[m
[32m+[m[32m-- Equivalencias OEM (códigos cruzados)[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS equivalencia ([m
[32m+[m[32m  id BIGSERIAL PRIMARY KEY,[m
[32m+[m[32m  producto_id BIGINT NOT NULL REFERENCES producto_logico(id) ON DELETE CASCADE,[m
[32m+[m[32m  codigo_externo TEXT NOT NULL,[m
[32m+[m[32m  marca_externa TEXT,[m
[32m+[m[32m  tipo TEXT NOT NULL DEFAULT 'oem',[m
[32m+[m[32m  confianza NUMERIC(3,2) DEFAULT 1.0[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_equivalencia_codigo ON equivalencia(codigo_externo);[m
[32m+[m
[32m+[m[32m-- Reglas de precio (qué oferta priorizar)[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS regla_precio ([m
[32m+[m[32m  id BIGSERIAL PRIMARY KEY,[m
[32m+[m[32m  empresa_id BIGINT NOT NULL REFERENCES empresa(id) ON DELETE CASCADE,[m
[32m+[m[32m  ambito TEXT NOT NULL,[m
[32m+[m[32m  ambito_valor TEXT,[m
[32m+[m[32m  estrategia TEXT NOT NULL DEFAULT 'menor_precio',[m
[32m+[m[32m  fuente_preferida_id BIGINT REFERENCES fuente_catalogo(id),[m
[32m+[m[32m  requiere_stock BOOLEAN NOT NULL DEFAULT true,[m
[32m+[m[32m  prioridad INT NOT NULL DEFAULT 0,[m
[32m+[m[32m  activa BOOLEAN NOT NULL DEFAULT true,[m
[32m+[m[32m  creado_at TIMESTAMPTZ NOT NULL DEFAULT now()[m
[32m+[m[32m);[m
[1mdiff --git a/db/02_clients.sql b/db/02_clients.sql[m
[1mnew file mode 100644[m
[1mindex 0000000..9c5c566[m
[1m--- /dev/null[m
[1m+++ b/db/02_clients.sql[m
[36m@@ -0,0 +1,70 @@[m
[32m+[m[32m-- =====================================================[m
[32m+[m[32m-- 02_clients.sql[m
[32m+[m[32m-- Esquema de clientes finales, sus canales y vehículos.[m
[32m+[m[32m-- =====================================================[m
[32m+[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS cliente ([m
[32m+[m[32m  id BIGSERIAL PRIMARY KEY,[m
[32m+[m[32m  empresa_id BIGINT NOT NULL REFERENCES empresa(id) ON DELETE CASCADE,[m
[32m+[m[32m  nombre TEXT,[m
[32m+[m[32m  apellido TEXT,[m
[32m+[m[32m  email TEXT,[m
[32m+[m[32m  notas TEXT,[m
[32m+[m[32m  etiquetas JSONB DEFAULT '[]'::jsonb,[m
[32m+[m[32m  creado_at TIMESTAMPTZ NOT NULL DEFAULT now(),[m
[32m+[m[32m  ultimo_contacto_at TIMESTAMPTZ[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_cliente_empresa ON cliente(empresa_id);[m
[32m+[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS contact_channel ([m
[32m+[m[32m  id BIGSERIAL PRIMARY KEY,[m
[32m+[m[32m  cliente_id BIGINT NOT NULL REFERENCES cliente(id) ON DELETE CASCADE,[m
[32m+[m[32m  tipo TEXT NOT NULL,[m
[32m+[m[32m  identificador TEXT NOT NULL,[m
[32m+[m[32m  verificado BOOLEAN NOT NULL DEFAULT false,[m
[32m+[m[32m  UNIQUE(tipo, identificador)[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_canal_cliente ON contact_channel(cliente_id);[m
[32m+[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS vehiculo_cliente ([m
[32m+[m[32m  id BIGSERIAL PRIMARY KEY,[m
[32m+[m[32m  cliente_id BIGINT NOT NULL REFERENCES cliente(id) ON DELETE CASCADE,[m
[32m+[m[32m  marca TEXT NOT NULL,[m
[32m+[m[32m  modelo TEXT NOT NULL,[m
[32m+[m[32m  anio INT,[m
[32m+[m[32m  motor TEXT,[m
[32m+[m[32m  patente TEXT,[m
[32m+[m[32m  notas TEXT[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_vehiculo_cliente ON vehiculo_cliente(cliente_id);[m
[32m+[m
[32m+[m[32m-- Función para obtener o crear cliente por canal (idempotente)[m
[32m+[m[32mCREATE OR REPLACE FUNCTION fn_get_or_create_cliente([m
[32m+[m[32m  p_empresa_id BIGINT,[m
[32m+[m[32m  p_canal_tipo TEXT,[m
[32m+[m[32m  p_canal_identificador TEXT[m
[32m+[m[32m) RETURNS BIGINT AS $$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m  v_cliente_id BIGINT;[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  SELECT c.id INTO v_cliente_id[m
[32m+[m[32m    FROM cliente c[m
[32m+[m[32m    JOIN contact_channel cc ON cc.cliente_id = c.id[m
[32m+[m[32m   WHERE c.empresa_id = p_empresa_id[m
[32m+[m[32m     AND cc.tipo = p_canal_tipo[m
[32m+[m[32m     AND cc.identificador = p_canal_identificador[m
[32m+[m[32m   LIMIT 1;[m
[32m+[m
[32m+[m[32m  IF v_cliente_id IS NULL THEN[m
[32m+[m[32m    INSERT INTO cliente (empresa_id) VALUES (p_empresa_id) RETURNING id INTO v_cliente_id;[m
[32m+[m[32m    INSERT INTO contact_channel (cliente_id, tipo, identificador)[m
[32m+[m[32m      VALUES (v_cliente_id, p_canal_tipo, p_canal_identificador);[m
[32m+[m[32m  END IF;[m
[32m+[m
[32m+[m[32m  UPDATE cliente SET ultimo_contacto_at = now() WHERE id = v_cliente_id;[m
[32m+[m[32m  RETURN v_cliente_id;[m
[32m+[m[32mEND;[m
[32m+[m[32m$$ LANGUAGE plpgsql;[m
[1mdiff --git a/db/03_conversations.sql b/db/03_conversations.sql[m
[1mnew file mode 100644[m
[1mindex 0000000..7a10ba5[m
[1m--- /dev/null[m
[1m+++ b/db/03_conversations.sql[m
[36m@@ -0,0 +1,77 @@[m
[32m+[m[32m-- =====================================================[m
[32m+[m[32m-- 03_conversations.sql[m
[32m+[m[32m-- Conversaciones, mensajes, consultas (agrupación de intención).[m
[32m+[m[32m-- =====================================================[m
[32m+[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS conversacion ([m
[32m+[m[32m  id BIGSERIAL PRIMARY KEY,[m
[32m+[m[32m  empresa_id BIGINT NOT NULL REFERENCES empresa(id) ON DELETE CASCADE,[m
[32m+[m[32m  cliente_id BIGINT NOT NULL REFERENCES cliente(id) ON DELETE CASCADE,[m
[32m+[m[32m  canal_tipo TEXT NOT NULL,[m
[32m+[m[32m  estado TEXT NOT NULL DEFAULT 'abierta',[m
[32m+[m[32m  iniciada_at TIMESTAMPTZ NOT NULL DEFAULT now(),[m
[32m+[m[32m  cerrada_at TIMESTAMPTZ[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_conv_empresa_estado ON conversacion(empresa_id, estado);[m
[32m+[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS mensaje ([m
[32m+[m[32m  id BIGSERIAL PRIMARY KEY,[m
[32m+[m[32m  conversacion_id BIGINT NOT NULL REFERENCES conversacion(id) ON DELETE CASCADE,[m
[32m+[m[32m  direccion TEXT NOT NULL,[m
[32m+[m[32m  tipo TEXT NOT NULL DEFAULT 'texto',[m
[32m+[m[32m  contenido TEXT,[m
[32m+[m[32m  media_url TEXT,[m
[32m+[m[32m  whatsapp_msg_id TEXT,[m
[32m+[m[32m  creado_at TIMESTAMPTZ NOT NULL DEFAULT now()[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_mensaje_conv ON mensaje(conversacion_id);[m
[32m+[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS consulta ([m
[32m+[m[32m  id BIGSERIAL PRIMARY KEY,[m
[32m+[m[32m  conversacion_id BIGINT NOT NULL REFERENCES conversacion(id) ON DELETE CASCADE,[m
[32m+[m[32m  intencion TEXT,[m
[32m+[m[32m  estado TEXT NOT NULL DEFAULT 'abierta',[m
[32m+[m[32m  iniciada_at TIMESTAMPTZ NOT NULL DEFAULT now(),[m
[32m+[m[32m  cerrada_at TIMESTAMPTZ[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_consulta_conv ON consulta(conversacion_id);[m
[32m+[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS intencion_log ([m
[32m+[m[32m  id BIGSERIAL PRIMARY KEY,[m
[32m+[m[32m  consulta_id BIGINT NOT NULL REFERENCES consulta(id) ON DELETE CASCADE,[m
[32m+[m[32m  intencion TEXT NOT NULL,[m
[32m+[m[32m  confianza NUMERIC(3,2),[m
[32m+[m[32m  datos JSONB,[m
[32m+[m[32m  creado_at TIMESTAMPTZ NOT NULL DEFAULT now()[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32m-- Vista de consultas del mes actual (para facturación)[m
[32m+[m[32mCREATE OR REPLACE VIEW v_consultas_mes_actual AS[m
[32m+[m[32mSELECT c.empresa_id, COUNT(*) AS consultas[m
[32m+[m[32m  FROM consulta cs[m
[32m+[m[32m  JOIN conversacion c ON c.id = cs.conversacion_id[m
[32m+[m[32m WHERE date_trunc('month', cs.iniciada_at) = date_trunc('month', now())[m
[32m+[m[32m GROUP BY c.empresa_id;[m
[32m+[m
[32m+[m[32m-- Función para cerrar consultas inactivas (>30 min sin mensaje)[m
[32m+[m[32mCREATE OR REPLACE FUNCTION fn_cerrar_consultas_inactivas() RETURNS INT AS $$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m  v_count INT;[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  UPDATE consulta SET estado = 'cerrada', cerrada_at = now()[m
[32m+[m[32m   WHERE estado = 'abierta'[m
[32m+[m[32m     AND id IN ([m
[32m+[m[32m       SELECT cs.id FROM consulta cs[m
[32m+[m[32m        JOIN conversacion c ON c.id = cs.conversacion_id[m
[32m+[m[32m        LEFT JOIN mensaje m ON m.conversacion_id = c.id[m
[32m+[m[32m        WHERE cs.estado = 'abierta'[m
[32m+[m[32m        GROUP BY cs.id[m
[32m+[m[32m       HAVING MAX(m.creado_at) < now() - INTERVAL '30 minutes'[m
[32m+[m[32m     );[m
[32m+[m[32m  GET DIAGNOSTICS v_count = ROW_COUNT;[m
[32m+[m[32m  RETURN v_count;[m
[32m+[m[32mEND;[m
[32m+[m[32m$$ LANGUAGE plpgsql;[m
[1mdiff --git a/db/04_orders_scoring.sql b/db/04_orders_scoring.sql[m
[1mnew file mode 100644[m
[1mindex 0000000..d949784[m
[1m--- /dev/null[m
[1m+++ b/db/04_orders_scoring.sql[m
[36m@@ -0,0 +1,60 @@[m
[32m+[m[32m-- =====================================================[m
[32m+[m[32m-- 04_orders_scoring.sql[m
[32m+[m[32m-- Pedidos, derivaciones a humano, scoring de conversaciones.[m
[32m+[m[32m-- =====================================================[m
[32m+[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS pedido ([m
[32m+[m[32m  id BIGSERIAL PRIMARY KEY,[m
[32m+[m[32m  empresa_id BIGINT NOT NULL REFERENCES empresa(id) ON DELETE CASCADE,[m
[32m+[m[32m  cliente_id BIGINT NOT NULL REFERENCES cliente(id) ON DELETE CASCADE,[m
[32m+[m[32m  consulta_id BIGINT REFERENCES consulta(id),[m
[32m+[m[32m  total NUMERIC(12,2) NOT NULL DEFAULT 0,[m
[32m+[m[32m  estado TEXT NOT NULL DEFAULT 'borrador',[m
[32m+[m[32m  creado_at TIMESTAMPTZ NOT NULL DEFAULT now()[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS pedido_item ([m
[32m+[m[32m  id BIGSERIAL PRIMARY KEY,[m
[32m+[m[32m  pedido_id BIGINT NOT NULL REFERENCES pedido(id) ON DELETE CASCADE,[m
[32m+[m[32m  producto_id BIGINT NOT NULL REFERENCES producto_logico(id),[m
[32m+[m[32m  cantidad INT NOT NULL DEFAULT 1,[m
[32m+[m[32m  precio_unitario NUMERIC(12,2) NOT NULL[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS derivacion ([m
[32m+[m[32m  id BIGSERIAL PRIMARY KEY,[m
[32m+[m[32m  consulta_id BIGINT NOT NULL REFERENCES consulta(id) ON DELETE CASCADE,[m
[32m+[m[32m  motivo TEXT,[m
[32m+[m[32m  resumen_contexto TEXT,[m
[32m+[m[32m  valor_cotizado NUMERIC(12,2),[m
[32m+[m[32m  estado TEXT NOT NULL DEFAULT 'pendiente',[m
[32m+[m[32m  asignado_a TEXT,[m
[32m+[m[32m  creado_at TIMESTAMPTZ NOT NULL DEFAULT now(),[m
[32m+[m[32m  resuelto_at TIMESTAMPTZ[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS score_consulta ([m
[32m+[m[32m  id BIGSERIAL PRIMARY KEY,[m
[32m+[m[32m  consulta_id BIGINT NOT NULL REFERENCES consulta(id) ON DELETE CASCADE,[m
[32m+[m[32m  score INT NOT NULL,[m
[32m+[m[32m  componente_1 INT,[m
[32m+[m[32m  componente_2 INT,[m
[32m+[m[32m  componente_3 INT,[m
[32m+[m[32m  componente_4 INT,[m
[32m+[m[32m  componente_5_tono INT,[m
[32m+[m[32m  oportunidades_mejora JSONB,[m
[32m+[m[32m  evaluado_at TIMESTAMPTZ NOT NULL DEFAULT now()[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32m-- Vista de salud del bot por empresa[m
[32m+[m[32mCREATE OR REPLACE VIEW v_salud_bot AS[m
[32m+[m[32mSELECT c.empresa_id,[m
[32m+[m[32m       COUNT(DISTINCT cs.id) AS consultas_total,[m
[32m+[m[32m       AVG(sc.score)::INT AS score_promedio,[m
[32m+[m[32m       COUNT(DISTINCT d.id) FILTER (WHERE d.estado = 'pendiente') AS derivaciones_pendientes[m
[32m+[m[32m  FROM consulta cs[m
[32m+[m[32m  JOIN conversacion c ON c.id = cs.conversacion_id[m
[32m+[m[32m  LEFT JOIN score_consulta sc ON sc.consulta_id = cs.id[m
[32m+[m[32m  LEFT JOIN derivacion d ON d.consulta_id = cs.id[m
[32m+[m[32m WHERE date_trunc('day', cs.iniciada_at) >= now() - INTERVAL '7 days'[m
[32m+[m[32m GROUP BY c.empresa_id;[m
