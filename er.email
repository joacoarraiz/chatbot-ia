[31m--- ----- Función helper: cerrar consultas por inactividad -----[m
[31m--- Corre cada N minutos (cron job). Cierra consultas con +30 min sin actividad.[m
[31m-CREATE OR REPLACE FUNCTION fn_cerrar_consultas_inactivas()[m
[31m-RETURNS INT AS $$[m
[31m-DECLARE[m
[31m-  v_cerradas INT;[m
[31m-BEGIN[m
[31m-  WITH inactivas AS ([m
[31m-    SELECT c.id[m
[31m-      FROM consulta c[m
[31m-     WHERE c.estado = 'abierta'[m
[31m-       AND NOT EXISTS ([m
[31m-         SELECT 1 FROM mensaje m[m
[31m-          WHERE m.consulta_id = c.id[m
[31m-            AND m.creado_at > now() - INTERVAL '30 minutes'[m
[31m-       )[m
[31m-  )[m
[31m-  UPDATE consulta[m
[31m-     SET estado = 'abandonada',[m
[31m-         cerrada_at = now(),[m
[31m-         motivo_cierre = 'inactividad'[m
[31m-   WHERE id IN (SELECT id FROM inactivas);[m
[31m-[m
[31m-  GET DIAGNOSTICS v_cerradas = ROW_COUNT;[m
[31m-  RETURN v_cerradas;[m
[31m-END;[m
[31m-$$ LANGUAGE plpgsql;[m
[31m-[m
[31m--- ----- Vista útil: consultas del mes por empresa -----[m
[31m-CREATE OR REPLACE VIEW v_consultas_mes_actual AS[m
[31m-SELECT[m
[31m-  e.id AS empresa_id,[m
[31m-  e.nombre AS empresa,[m
[31m-  e.plan,[m
[31m-  e.consultas_limite,[m
[31m-  COUNT(c.id) AS consultas_usadas,[m
[31m-  e.consultas_limite - COUNT(c.id) AS consultas_restantes,[m
[31m-  ROUND(100.0 * COUNT(c.id) / NULLIF(e.consultas_limite, 0), 1) AS porcentaje_usado[m
[31m-FROM empresa e[m
[31m-LEFT JOIN consulta c[m
[31m-  ON c.empresa_id = e.id[m
[31m- AND c.iniciada_at >= date_trunc('month', now())[m
[31m-GROUP BY e.id;[m
