[31m-  codigo_externo TEXT NOT NULL,[m
[31m-  marca_externa TEXT,[m
[31m-  confianza NUMERIC(3,2) DEFAULT 1.0,           -- 0..1, evita fusiones dudosas[m
[31m-  fuente TEXT,                                  -- de dónde salió esta equivalencia[m
[31m-  notas TEXT[m
[31m-);[m
[31m-CREATE INDEX IF NOT EXISTS idx_equiv_producto ON equivalencia(producto_id);[m
[31m-CREATE INDEX IF NOT EXISTS idx_equiv_codigo ON equivalencia(codigo_externo);[m
[31m-[m
[31m--- ----- REGLA DE PRECIO -----[m
[31m--- ★ Define qué oferta gana cuando hay varias para el mismo producto.[m
[31m--- Funciona como especificidad de CSS: gana la más específica.[m
[31m-CREATE TABLE IF NOT EXISTS regla_precio ([m
[31m-  id BIGSERIAL PRIMARY KEY,[m
[31m-  empresa_id BIGINT REFERENCES empresa ON DELETE CASCADE,[m
[31m-  ambito TEXT NOT NULL,                         -- 'producto'|'marca'|'linea'|'global'[m
[31m-  ambito_valor TEXT,                            -- id, marca, línea o NULL si global[m
[31m-  estrategia TEXT NOT NULL,                     -- 'lista_fija'|'menor_precio'|'mayor_margen'|'fallback'[m
[31m-  fuente_preferida_id BIGINT REFERENCES fuente_catalogo,[m
[31m-  orden_fallback BIGINT[],                      -- array de fuente_ids[m
[31m-  requiere_stock BOOLEAN DEFAULT true,[m
[31m-  prioridad INT NOT NULL,                       -- producto=100, marca=50, linea=30, global=0[m
[31m-  activa BOOLEAN DEFAULT true,[m
[31m-  creado_at TIMESTAMPTZ DEFAULT now()[m
[31m-);[m
[31m-CREATE INDEX IF NOT EXISTS idx_regla_empresa_prioridad[m
[31m-  ON regla_precio(empresa_id, prioridad DESC);[m
[31m-[m
[31m--- ----- Vista útil: precio recomendado por producto -----[m
[31m--- Se puede consultar como tabla pero recalcula al vuelo.[m
[31m--- Esta es una versión simple; la real va a estar en una función PL/pgSQL.[m
[31m-CREATE OR REPLACE VIEW v_producto_con_precio AS[m
[31m-SELECT[m
[31m-  p.id AS producto_id,[m
[31m-  p.empresa_id,[m
[31m-  p.descripcion,[m
[31m-  p.marca_pieza,[m
[31m-  p.linea,[m
[31m-  (SELECT o.precio FROM oferta o[m
[31m-     WHERE o.producto_id = p.id AND o.stock > 0[m
[31m-     ORDER BY o.precio ASC LIMIT 1) AS precio_min_con_stock,[m
[31m-  (SELECT COUNT(*) FROM oferta o[m
[31m-     WHERE o.producto_id = p.id AND o.stock > 0) AS fuentes_con_stock,[m
[31m-  (SELECT SUM(o.stock) FROM oferta o WHERE o.producto_id = p.id) AS stock_total[m
[31m-FROM producto_logico p;[m
