[31m-<script>[m
[31m-// ============ DATA ============[m
[31m-const SECTIONS = [[m
[31m-  {[m
[31m-    id: 'decisiones',[m
[31m-    title: 'Decisiones de equipo',[m
[31m-    desc: 'Lo que hay que cerrar entre Eze, Seba, Fran y vos antes de que tenga sentido escribir código.',[m
[31m-    items: [[m
[31m-      { id:'d1', label:'Aprobar el diseño técnico Etapa 1', hint:'Leer `docs/Diseno_Tecnico_Etapa1.md` y discutir las 5 decisiones grandes en reunión.' },[m
[31m-      { id:'d2', label:'Confirmar nombre del producto', hint:'En los mockups usamos "Toni". Si cambia, hay que actualizar `persona_config`.' },[m
[31m-      { id:'d3', label:'Elegir autopartista piloto', hint:'Buscamos 1 (idealmente 2) comercio dispuesto a probar el bot 4-6 semanas. Argentino, con catálogo en Excel/CSV.' },[m
[31m-      { id:'d4', label:'Conseguir Excel real del piloto', hint:'Anonimizado si hace falta. Esto es lo más crítico — sin datos reales, todo lo demás es teoría.', tip:true },[m
[31m-      { id:'d5', label:'Definir quién opera la bandeja humana en el piloto', hint:'Cuando el bot deriva, alguien atiende. Hay que entrenar a esa persona.' },[m
[31m-      { id:'d6', label:'Consultar a Tapice qué API/export expone', hint:'No tienen API pública documentada. Preguntar directo.' },[m
[31m-      { id:'d7', label:'Consultar a Lupa qué API/export expone', hint:'Idem Tapice.' },[m
[31m-      { id:'d8', label:'Acordar política de precios cuando se excede el plan', hint:'¿Cortamos servicio o cobramos overage por consulta extra? Recomendamos overage.' },[m
[31m-    ][m
[31m-  },[m
[31m-  {[m
[31m-    id: 'infra',[m
[31m-    title: 'Infraestructura — cuentas y credenciales',[m
[31m-    desc: 'Sacar todas las cuentas en paralelo. La de Meta tarda 5-10 días, empezar ya.',[m
[31m-    items: [[m
[31m-      { id:'i1', label:'Crear organización en GitHub para el equipo', hint:'Una vez creada, todos los repos quedan ahí. Plan gratuito alcanza.' },[m
[31m-      { id:'i2', label:'Crear repo privado `toni-bot`', hint:'Subir esta estructura inicial (los archivos que te paso).' },[m
[31m-      { id:'i3', label:'Sumar a Eze, Seba y Fran al repo', hint:'Settings → Collaborators → invitar por usuario de GitHub.' },[m
[31m-      { id:'i4', label:'Crear cuenta en Supabase', hint:'<a href="https://supabase.com" target="_blank">supabase.com</a> — usar email del equipo, no personal.' },[m
[31m-      { id:'i5', label:'Crear proyecto Supabase', hint:'Región: <code>South America (São Paulo)</code> por latencia con Argentina. Guardar la contraseña de la BD en un manager.' },[m
[31m-      { id:'i6', label:'Copiar URL + anon key del proyecto', hint:'Settings → API. Pegarlos en el archivo <code>.env</code> del repo.' },[m
[31m-      { id:'i7', label:'Copiar service_role key del proyecto', hint:'Misma pantalla. Es la clave de admin, va al <code>.env</code> también pero NUNCA al frontend.', tip:true },[m
[31m-      { id:'i8', label:'Crear cuenta en Meta for Business', hint:'<a href="https://business.facebook.com" target="_blank">business.facebook.com</a>. Si el comercio piloto ya tiene, lo agregamos como asset.' },[m
[31m-      { id:'i9', label:'Iniciar verificación de empresa en Meta', hint:'Sube documentación (CUIT/inscripción). Tarda 5-10 días hábiles. EMPEZAR YA.', tip:true },[m
[31m-      { id:'i10', label:'Crear WhatsApp Business Account (WABA)', hint:'Una vez aprobada la empresa. Asociar el número del comercio piloto.' },[m
[31m-      { id:'i11', label:'Generar access_token permanente y guardar en .env', hint:'No usar el token temporal de 24h — generar uno permanente desde "System User".' },[m
[31m-      { id:'i12', label:'Crear cuenta en Anthropic Console', hint:'<a href="https://console.anthropic.com" target="_blank">console.anthropic.com</a>. Pedir API key. Cargar saldo inicial USD 50-100.' },[m
[31m-      { id:'i13', label:'Configurar tope de gasto en Anthropic', hint:'Usage limits → setear máximo mensual. Evita sorpresas durante desarrollo.' },[m
[31m-      { id:'i14', label:'Decidir hosting del backend', hint:'Opciones: Cloud Run (Google), Railway, Render, Fly.io. Para empezar recomiendo Railway por simplicidad. Sin estado interno.' },[m
[31m-    ][m
[31m-  },[m
[31m-  {[m
[31m-    id: 'db',[m
[31m-    title: 'Base de datos — correr los SQL',[m
[31m-    desc: 'En orden, desde el SQL Editor de Supabase. Cada archivo es idempotente (se puede correr varias veces sin romper).',[m
[31m-    items: [[m
[31m-      { id:'b1', label:'Abrir SQL Editor en Supabase', hint:'En el panel del proyecto, ícono <code>&lt;/&gt;</code> a la izquierda.' },[m
[31m-      { id:'b2', label:'Correr <code>db/01_catalog.sql</code>', hint:'Crea: empresa, fuente_catalogo, producto_logico, oferta, aplicacion, equivalencia, regla_precio.' },[m
[31m-      { id:'b3', label:'Correr <code>db/02_clients.sql</code>', hint:'Crea: cliente, contact_channel, vehiculo_cliente + función helper `fn_get_or_create_cliente`.' },[m
[31m-      { id:'b4', label:'Correr <code>db/03_conversations.sql</code>', hint:'Crea: conversacion, mensaje, consulta, intencion_log + vista `v_consultas_mes_actual`.' },[m
[31m-      { id:'b5', label:'Correr <code>db/04_orders_scoring.sql</code>', hint:'Crea: pedido, pedido_item, derivacion, score_consulta + vistas de salud del bot.' },[m
[31m-      { id:'b6', label:'Correr <code>db/05_rls.sql</code>', hint:'Activa Row Level Security en todas las tablas. Sin esto, un bug puede mezclar datos entre empresas.', tip:true },[m
[31m-      { id:'b7', label:'Verificar tablas en Table Editor', hint:'Las 17 tablas tienen que aparecer en el panel.' },[m
[31m-      { id:'b8', label:'Crear empresa piloto en tabla `empresa`', hint:'INSERT con nombre, plan=\'basico\', whatsapp_phone_id (cuando esté), persona_config inicial.' },[m
[31m-      { id:'b9', label:'Configurar bucket de Storage para archivos', hint:'Storage → New bucket → "media" (privado). Acá van audios e imágenes.' },[m
[31m-      { id:'b10', label:'Setear backup diario en Supabase', hint:'Settings → Database → Backups. Plan free tiene 7 días retención automática.' },[m
[31m-    ][m
[31m-  },[m
[31m-  {[m
[31m-    id: 'catalogo',[m
[31m-    title: 'Cargar el catálogo del piloto',[m
[31m-    desc: 'Acá se gana o se pierde el proyecto. La calidad del catálogo determina la calidad del bot.',[m
[31m-    items: [[m
[31m-      { id:'c1', label:'Recibir Excel del piloto', hint:'Pedir todas las columnas que usan, sin recortar. Mejor exceso que defecto.' },[m
[31m-      { id:'c2', label:'Auditar el Excel manualmente', hint:'¿Cuántos productos? ¿Está la aplicación (qué auto)? ¿Hay códigos OEM? ¿Hay equivalencias? Esto define cuánto trabajo de normalización viene.' },[m
[31m-      { id:'c3', label:'Mapear columnas → esquema canónico', hint:'Cada columna del Excel a un campo nuestro. Guardar el mapeo en `fuente_catalogo.mapeo`.' },[m
[31m-      { id:'c4', label:'Script de carga: Excel → producto_logico', hint:'Lo pasaré en Python. Idempotente: se puede correr cada noche y actualiza.' },[m
[31m-      { id:'c5', label:'Script de carga: → ofertas (precios/stock)', hint:'Las ofertas son las que cambian. Esta carga se repite seguido.' },[m
[31m-      { id:'c6', label:'Script de carga: → aplicaciones (qué autos)', hint:'A veces vienen en columnas separadas, a veces concatenadas en una sola. Hay que parsear.' },[m
[31m-      { id:'c7', label:'Script de carga: → equivalencias (códigos)', hint:'Si existe la info de OEM/cruzadas, cargarla. Si no, queda para Etapa 2.' },[m
[31m-      { id:'c8', label:'Validar con búsquedas de prueba', hint:'Buscar 10 productos a mano. ¿Aparecen? ¿El precio coincide? ¿La aplicación es correcta?' },[m
[31m-      { id:'c9', label:'Documentar el formato del piloto', hint:'Un archivo `docs/piloto-X.md` con cómo viene su catálogo. Sirve para sumar al próximo.' },[m
[31m-    ][m
[31m-  },[m
[31m-  {[m
[31m-    id: 'bot-min',[m
[31m-    title: 'Bot funcionando — versión mínima',[m
[31m-    desc: 'El núcleo: que un mensaje entre por WhatsApp y el bot busque en el catálogo y responda.',[m
[31m-    items: [[m
[31m-      { id:'m1', label:'Setear webhook de WhatsApp', hint:'Apuntar el webhook de Meta al endpoint del backend. Verify token = el del `.env`.' },[m
[31m-      { id:'m2', label:'Endpoint POST /webhook que valide firma', hint:'Meta firma cada request con HMAC. Si no validás, cualquiera puede mandar mensajes falsos.' },[m
[31m-      { id:'m3', label:'Guardar cada mensaje en tabla `mensaje`', hint:'Antes de cualquier procesamiento. Si algo falla, queda el log.' },[m
[31m-      { id:'m4', label:'Crear/obtener cliente con `fn_get_or_create_cliente`', hint:'Es la función que ya está en `02_clients.sql`. Cliente nuevo → fila nueva. Cliente conocido → trae sus stats.' },[m
[31m-      { id:'m5', label:'Abrir/continuar conversación', hint:'Si la última está abierta y reciente (<30 min), seguir. Si no, abrir nueva.' },[m
[31m-      { id:'m6', label:'Implementar Agente Router', hint:'El clasificador. Modelo barato (Haiku). Prompt en `agents/router/prompt.md`.' },[m
[31m-      { id:'m7', label:'Decidir si abrir consulta nueva o continuar', hint:'Lógica de "cuenta como consulta" del diseño. Saludo/cierre → no. Necesidad nueva → sí.' },[m
[31m-      { id:'m8', label:'Implementar tool `buscar_producto`', hint:'Función SQL/Python. Recibe descripción, devuelve top 5 matches con score.' },[m
[31m-      { id:'m9', label:'Implementar tool `consultar_stock`', hint:'Por producto_id → suma de stock por fuente.' },[m
[31m-      { id:'m10', label:'Implementar tool `consultar_precio`', hint:'Aplica las `regla_precio` para devolver el precio recomendado.' },[m
[31m-      { id:'m11', label:'Implementar tool `buscar_equivalencia`', hint:'Por código externo → producto_logico match.' },[m
[31m-      { id:'m12', label:'Implementar tool `buscar_por_aplicacion`', hint:'Por marca + modelo + año → productos compatibles.' },[m
[31m-      { id:'m13', label:'Implementar Agente Producto con sus tools', hint:'El primer especialista. Prompt en `agents/product/prompt.md`.' },[m
[31m-      { id:'m14', label:'Loop: respuesta del bot → enviar a WhatsApp Cloud API', hint:'POST a la API de Meta con el texto. Guardar wamid en `mensaje.whatsapp_msg_id`.' },[m
[31m-      { id:'m15', label:'Manejar el typing indicator', hint:'Mostrar "escribiendo..." mientras el LLM piensa. Detalle de UX que importa.' },[m
[31m-      { id:'m16', label:'Probar end-to-end con número de prueba', hint:'Meta da un número sandbox. Mandar "hola", "pastillas Gol 1.6 2010", ver que responde con datos reales.' },[m
[31m-    ][m
[31m-  },[m
[31m-  {[m
[31m-    id: 'agentes',[m
[31m-    title: 'Resto de agentes especializados',[m
[31m-    desc: 'Una vez que el Producto anda, sumamos los demás. Pueden ir en paralelo entre devs.',[m
[31m-    items: [[m
[31m-      { id:'a1', label:'Agente Cotización + tool `armar_pedido`', hint:'Cierra ventas. Crea registro en `pedido` y `pedido_item`.' },[m
[31m-      { id:'a2', label:'Agente Cotización: aplicar reglas de precio', hint:'Para clientes B2B en el futuro: lista mayorista vs minorista.' },[m
[31m-      { id:'a3', label:'Agente Pedido + tool `consultar_pedido`', hint:'"¿llegó mi pedido?", "¿cuándo está listo?".' },[m
[31m-      { id:'a4', label:'Agente FAQ + tool `consultar_info_empresa`', hint:'Horarios, ubicación, métodos de pago. Lee `empresa.persona_config` y campos.' },[m
[31m-      { id:'a5', label:'Agente Derivación + tool `derivar_humano`', hint:'Crea registro en `derivacion` con resumen del contexto.' },[m
[31m-      { id:'a6', label:'Agente Derivación: armado del resumen', hint:'El resumen es CLAVE: cliente + auto + qué busca + qué se ofreció + dónde se trabó. Es lo que ve el vendedor.', tip:true },[m
[31m-      { id:'a7', label:'Definir reglas de derivación por empresa', hint:'En `persona_config`: ¿deriva automático fuera de horario? ¿deriva si lead vale >X? Cada comercio decide.' },[m
[31m-      { id:'a8', label:'Agente Auditor — script de scoring', hint:'Componentes 1, 2, 3 y 5 son determinísticos. Solo el de tono usa LLM.' },[m
[31m-      { id:'a9', label:'Cron job nocturno de scoring', hint:'Corre 3 AM, agarra consultas cerradas del día, llena `score_consulta`.' },[m
[31m-      { id:'a10', label:'Cron job de cierre por inactividad', hint:'Cada 5 min, llama `fn_cerrar_consultas_inactivas()` ya creada.' },[m
[31m-      { id:'a11', label:'Cron job de recálculo de etiquetas de cliente', hint:'1 vez por día. Recalcula `recurrente`, `candidato_b2b`, `dormido`, `frio`.' },[m
[31m-    ][m
[31m-  },[m
[31m-  {[m
[31m-    id: 'multimodal',[m
