[31m-        "hola",[m
[31m-        "necesito pastillas delanteras para un Gol 1.6 2010",[m
[31m-        "tenés el BP1234567?",[m
[31m-        "gracias!",[m
[31m-        "che, quiero hablar con alguien",[m
[31m-        "delanteras",  # respuesta a desambiguación[m
[31m-    ][m
[31m-    for m in casos:[m
[31m-        try:[m
[31m-            out = clasificar(m)[m
[31m-            print(f"\n📨 {m!r}")[m
[31m-            print(json.dumps(out.to_dict(), indent=2, ensure_ascii=False))[m
[31m-        except Exception as e:[m
[31m-            print(f"❌ Error con {m!r}: {e}")[m
