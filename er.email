[31m-[m
[31m-### Bloque C — Conversaciones, mensajes y consultas[m
[31m-[m
[31m-```sql[m
[31m--- Una "sesión" de chat abierta con un cliente[m
[31m-CREATE TABLE conversacion ([m
[31m-  id BIGSERIAL PRIMARY KEY,[m
[31m-  empresa_id BIGINT REFERENCES empresa ON DELETE CASCADE,[m
[31m-  cliente_id BIGINT REFERENCES cliente,[m
[31m-  canal TEXT NOT NULL,[m
[31m-  abierta_at TIMESTAMPTZ DEFAULT now(),[m
[31m-  cerrada_at TIMESTAMPTZ,[m
[31m-  cerrada_por TEXT,                        -- 'inactividad'|'cliente'|'derivacion'|'venta'[m
[31m-  estado TEXT DEFAULT 'activa'             -- 'activa'|'derivada'|'cerrada'[m
[31m-);[m
[31m-CREATE INDEX idx_conv_empresa_estado ON conversacion(empresa_id, estado);[m
[31m-CREATE INDEX idx_conv_cliente ON conversacion(cliente_id);[m
[31m-[m
[31m--- Cada mensaje individual (cliente o bot o humano)[m
[31m-CREATE TABLE mensaje ([m
[31m-  id BIGSERIAL PRIMARY KEY,[m
[31m-  conversacion_id BIGINT REFERENCES conversacion ON DELETE CASCADE,[m
[31m-  consulta_id BIGINT,                      -- nullable: saludos/gracias no atan a consulta[m
[31m-  emisor TEXT NOT NULL,                    -- 'cliente'|'bot'|'humano'[m
