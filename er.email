[31m-        return 8, "Auditor devolvió JSON inválido; score neutral asignado.", [][m
[31m-[m
[31m-    return data["score_tono"], data["observaciones"], data["oportunidades_mejora"][m
[31m-[m
[31m-[m
[31m-def _parse_json(raw: str) -> dict:[m
[31m-    if "```" in raw:[m
[31m-        m = re.search(r"```(?:json)?\s*(.*?)\s*```", raw, re.DOTALL)[m
[31m-        if m:[m
[31m-            raw = m.group(1)[m
[31m-    start = raw.find("{")[m
