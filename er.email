[31m-        m = re.search(r"```(?:json)?\s*(.*?)\s*```", raw, re.DOTALL)[m
[31m-        if m:[m
[31m-            raw = m.group(1)[m
[31m-    # Sacar texto antes/después del JSON[m
[31m-    start = raw.find("{")[m
