[31m-[m
[31m-# ---------- Búsqueda por código (equivalencias) ----------[m
[31m-[m
[31m-def buscar_equivalencia(empresa_id: int, codigo_externo: str) -> dict:[m
[31m-    """[m
[31m-    Dado un código OEM o de marca externa, encuentra el producto lógico[m
