[31m-    items: [[m
[31m-      { id:'p1', label:'Auth de Supabase para los comercios', hint:'Email + password para el dueño/vendedor del comercio. Cada uno solo ve sus datos (RLS).' },[m
[31m-      { id:'p2', label:'Vista CRM con lista de clientes', hint:'La que ya está mockeada en el demo. Buscador + filtro por estado.' },[m
