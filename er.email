[31m-[m
[31m-CREATE TABLE regla_precio ([m
[31m-  id BIGSERIAL PRIMARY KEY,[m
[31m-  empresa_id BIGINT REFERENCES empresa ON DELETE CASCADE,[m
[31m-  ambito TEXT,                             -- 'producto'|'marca'|'linea'|'global'[m
[31m-  ambito_valor TEXT,[m
[31m-  estrategia TEXT,                         -- 'lista_fija'|'menor_precio'|'mayor_margen'|'fallback'[m
[31m-  fuente_preferida_id BIGINT,[m
[31m-  orden_fallback BIGINT[],[m
