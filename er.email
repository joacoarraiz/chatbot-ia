[31m-"""[m
[31m-scripts/compute_scores.py[m
[31m-Job nocturno que puntúa todas las consultas cerradas que aún no tienen score.[m
[31m-[m
[31m-Componentes determinísticos (los calcula Python sobre la BD):[m
[31m-  - score_resolucion (0-40)[m
[31m-  - score_datos     (0-20)[m
[31m-  - score_eficiencia(0-15)[m
[31m-  - score_conversion(0-10)[m
[31m-[m
[31m-Componente subjetivo (lo calcula el agente Auditor con LLM):[m
[31m-  - score_tono     (0-15) + observaciones + oportunidades_mejora[m
[31m-[m
[31m-Uso:[m
[31m-    python -m scripts.compute_scores[m
[31m-    python -m scripts.compute_scores --dias 7   # backfill 7 días[m
[31m-"""[m
[31m-from __future__ import annotations[m
[31m-[m
[31m-import argparse[m
[31m-import json[m
[31m-import os[m
[31m-import re[m
[31m-from datetime import datetime, timezone, timedelta[m
[31m-from pathlib import Path[m
[31m-[m
[31m-import anthropic[m
