[31m-   WHERE r.empresa_id = p_empresa_id[m
[31m-     AND r.activa = true[m
[31m-     AND ([m
[31m-       (r.ambito = 'producto' AND r.ambito_valor = p_producto_id::TEXT)[m
[31m-       OR (r.ambito = 'marca'  AND r.ambito_valor = v_marca)[m
[31m-       OR (r.ambito = 'linea'  AND r.ambito_valor = v_linea)[m
[31m-       OR (r.ambito = 'global')[m
[31m-     )[m
[31m-   ORDER BY r.prioridad DESC[m
[31m-   LIMIT 1;[m
[31m-[m
[31m-  IF v_regla IS NULL THEN[m
[31m-    -- Sin regla: precio = oferta más barata con stock[m
[31m-    SELECT o.id, o.precio, o.fuente_id INTO v_oferta[m
[31m-      FROM oferta o[m
[31m-     WHERE o.producto_id = p_producto_id AND o.stock > 0[m
[31m-     ORDER BY o.precio ASC LIMIT 1;[m
[31m-    IF v_oferta IS NULL THEN[m
[31m-      RETURN;[m
[31m-    END IF;[m
[31m-    RETURN QUERY SELECT p_producto_id, v_oferta.precio, v_oferta.id,[m
[31m-                        v_oferta.fuente_id, NULL::BIGINT, 'sin_regla';[m
[31m-    RETURN;[m
[31m-  END IF;[m
[31m-[m
[31m-  -- Aplicar estrategia de la regla[m
[31m-  IF v_regla.estrategia = 'menor_precio' THEN[m
[31m-    SELECT o.id, o.precio, o.fuente_id INTO v_oferta[m
[31m-      FROM oferta o[m
[31m-     WHERE o.producto_id = p_producto_id[m
[31m-       AND (NOT v_regla.requiere_stock OR o.stock > 0)[m
[31m-     ORDER BY o.precio ASC LIMIT 1;[m
[31m-  ELSIF v_regla.estrategia = 'mayor_margen' THEN[m
[31m-    SELECT o.id, o.precio, o.fuente_id INTO v_oferta[m
[31m-      FROM oferta o[m
[31m-     WHERE o.producto_id = p_producto_id[m
[31m-       AND (NOT v_regla.requiere_stock OR o.stock > 0)[m
[31m-     ORDER BY (o.precio - COALESCE(o.costo, 0)) DESC LIMIT 1;[m
[31m-  ELSIF v_regla.estrategia = 'lista_fija' AND v_regla.fuente_preferida_id IS NOT NULL THEN[m
[31m-    SELECT o.id, o.precio, o.fuente_id INTO v_oferta[m
[31m-      FROM oferta o[m
[31m-     WHERE o.producto_id = p_producto_id[m
[31m-       AND o.fuente_id = v_regla.fuente_preferida_id[m
[31m-       AND (NOT v_regla.requiere_stock OR o.stock > 0)[m
[31m-     LIMIT 1;[m
[31m-  END IF;[m
[31m-[m
[31m-  -- Fallback si la regla no encontró nada[m
[31m-  IF v_oferta IS NULL THEN[m
[31m-    SELECT o.id, o.precio, o.fuente_id INTO v_oferta[m
[31m-      FROM oferta o[m
[31m-     WHERE o.producto_id = p_producto_id AND o.stock > 0[m
[31m-     ORDER BY o.precio ASC LIMIT 1;[m
[31m-  END IF;[m
[31m-[m
[31m-  IF v_oferta IS NULL THEN[m
[31m-    RETURN;[m
[31m-  END IF;[m
[31m-[m
[31m-  RETURN QUERY SELECT p_producto_id, v_oferta.precio, v_oferta.id,[m
[31m-                      v_oferta.fuente_id, v_regla.id, v_regla.estrategia;[m
[31m-END;[m
[31m-$$;[m
