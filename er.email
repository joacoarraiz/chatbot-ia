[31m-    if start != -1 and end != -1:[m
[31m-        raw = raw[start : end + 1][m
[31m-    return json.loads(raw)[m
[31m-[m
[31m-[m
[31m-# ---------- Pipeline ----------[m
[31m-[m
[31m-def calcular_banda(total: int) -> str:[m
[31m-    if total <= 40:[m
[31m-        return "mala"[m
[31m-    if total <= 70:[m
[31m-        return "regular"[m
[31m-    return "buena"[m
[31m-[m
[31m-[m
[31m-def puntuar_consulta(consulta_id: int) -> dict:[m
[31m-    db = get_client()[m
[31m-[m
[31m-    # Cargar consulta[m
[31m-    c = db.table("consulta").select("*").eq("id", consulta_id).execute().data[m
[31m-    if not c:[m
[31m-        return {"error": f"consulta {consulta_id} no existe"}[m
[31m-    consulta = c[0][m
[31m-[m
[31m-    # Cargar mensajes[m
[31m-    mensajes = db.table("mensaje").select("emisor, contenido, metadata, creado_at")\[m
[31m-                                  .eq("consulta_id", consulta_id)\[m
[31m-                                  .order("creado_at").execute().data or [][m
[31m-[m
[31m-    # Cargar derivacion (si hay)[m
[31m-    deriv_data = db.table("derivacion").select("*")\[m
[31m-                                       .eq("consulta_id", consulta_id).execute().data[m
[31m-    derivacion = deriv_data[0] if deriv_data else None[m
[31m-[m
[31m-    # Cargar pedido (si hay)[m
[31m-    pedido_data = db.table("pedido").select("*")\[m
[31m-                                    .eq("consulta_id", consulta_id).execute().data[m
[31m-    pedido = pedido_data[0] if pedido_data else None[m
[31m-[m
[31m-    # Calcular cada componente[m
[31m-    s_res  = score_resolucion(consulta, derivacion)[m
[31m-    s_dat  = score_datos(mensajes)[m
[31m-    s_efi  = score_eficiencia(mensajes)[m
[31m-    s_conv = score_conversion(consulta, pedido)[m
[31m-    s_ton, obs, opps = score_tono_y_observaciones(consulta, mensajes)[m
