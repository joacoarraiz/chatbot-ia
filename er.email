[31m--- =====================================================[m
[31m--- 01_catalog.sql[m
[31m--- Catálogo: empresas, fuentes, productos, ofertas,[m
[31m--- aplicaciones, equivalencias y reglas de precio.[m
[31m--- Correr PRIMERO. Idempotente (se puede correr varias veces).[m
[31m--- =====================================================[m
[31m-[m
[31m--- ----- EMPRESA (multi-tenant) -----[m
[31m-CREATE TABLE IF NOT EXISTS empresa ([m
[31m-  id BIGSERIAL PRIMARY KEY,[m
[31m-  nombre TEXT NOT NULL,[m
[31m-  plan TEXT NOT NULL DEFAULT 'prueba',          -- 'prueba'|'basico'|'pro'[m
[31m-  consultas_limite INT NOT NULL DEFAULT 100,[m
[31m-  persona_config JSONB,                         -- tono, jerga, branding, derivación[m
[31m-  whatsapp_phone_id TEXT,                       -- ID del número en Meta[m
[31m-  whatsapp_business_id TEXT,                    -- ID del WABA[m
[31m-  horario_atencion JSONB,                       -- {"lun":"9-18", ...}[m
[31m-  zona_horaria TEXT DEFAULT 'America/Argentina/Buenos_Aires',[m
[31m-  activo BOOLEAN DEFAULT true,[m
[31m-  creado_at TIMESTAMPTZ DEFAULT now()[m
[31m-);[m
[31m-COMMENT ON TABLE empresa IS 'Cada autopartista que contrata Toni';[m
[31m-[m
[31m--- ----- FUENTE DE CATÁLOGO -----[m
[31m--- Cada origen de datos: API, Excel, Drive, etc.[m
[31m-CREATE TABLE IF NOT EXISTS fuente_catalogo ([m
[31m-  id BIGSERIAL PRIMARY KEY,[m
[31m-  empresa_id BIGINT REFERENCES empresa ON DELETE CASCADE,[m
[31m-  nombre TEXT NOT NULL,[m
[31m-  tipo TEXT NOT NULL,                           -- 'api'|'excel'|'csv'|'drive'|'scraping'[m
[31m-  mapeo JSONB,                                  -- plantilla columna→campo[m
[31m-  config JSONB,                                 -- credenciales/URL/path[m
[31m-  sincronizado_at TIMESTAMPTZ,[m
[31m-  estado TEXT DEFAULT 'activa',                 -- 'activa'|'pausada'|'error'[m
[31m-  ultimo_error TEXT,[m
[31m-  creado_at TIMESTAMPTZ DEFAULT now()[m
[31m-);[m
[31m-CREATE INDEX IF NOT EXISTS idx_fuente_empresa ON fuente_catalogo(empresa_id);[m
[31m-[m
[31m--- ----- PRODUCTO LÓGICO -----[m
[31m--- La pieza canónica. Una sola por empresa, aunque venga en varios catálogos.[m
[31m-CREATE TABLE IF NOT EXISTS producto_logico ([m
[31m-  id BIGSERIAL PRIMARY KEY,[m
[31m-  empresa_id BIGINT REFERENCES empresa ON DELETE CASCADE,[m
[31m-  descripcion TEXT NOT NULL,[m
[31m-  marca_pieza TEXT,[m
[31m-  linea TEXT,                                   -- frenos, motor, suspensión...[m
[31m-  atributos JSONB,                              -- material, especificaciones, etc.[m
[31m-  imagen_url TEXT,[m
[31m-  creado_at TIMESTAMPTZ DEFAULT now()[m
[31m-);[m
[31m-CREATE INDEX IF NOT EXISTS idx_producto_empresa ON producto_logico(empresa_id);[m
[31m-CREATE INDEX IF NOT EXISTS idx_producto_marca ON producto_logico(empresa_id, marca_pieza);[m
[31m-CREATE INDEX IF NOT EXISTS idx_producto_linea ON producto_logico(empresa_id, linea);[m
[31m--- Búsqueda full-text en español[m
[31m-CREATE INDEX IF NOT EXISTS idx_producto_descripcion[m
[31m-  ON producto_logico USING gin(to_tsvector('spanish', descripcion));[m
[31m-[m
[31m--- ----- OFERTA -----[m
[31m--- ★ Mismo producto, distinta fuente y precio.[m
[31m--- Acá vive la solución a "varios catálogos con el mismo producto a distinto precio".[m
[31m-CREATE TABLE IF NOT EXISTS oferta ([m
[31m-  id BIGSERIAL PRIMARY KEY,[m
[31m-  producto_id BIGINT REFERENCES producto_logico ON DELETE CASCADE,[m
