[31m-  es_default BOOLEAN DEFAULT false,             -- el que el bot asume por defecto[m
[31m-  notas TEXT,                                   -- "este lo usa la esposa", etc.[m
[31m-  creado_at TIMESTAMPTZ DEFAULT now()[m
[31m-);[m
[31m-CREATE INDEX IF NOT EXISTS idx_veh_cliente ON vehiculo_cliente(cliente_id);[m
[31m-[m
[31m--- ----- Trigger para asegurar que solo haya UN default por cliente -----[m
[31m-CREATE OR REPLACE FUNCTION fn_un_default_por_cliente()[m
[31m-RETURNS TRIGGER AS $$[m
[31m-BEGIN[m
[31m-  IF NEW.es_default = true THEN[m
[31m-    UPDATE vehiculo_cliente[m
[31m-       SET es_default = false[m
[31m-     WHERE cliente_id = NEW.cliente_id[m
[31m-       AND id <> NEW.id;[m
[31m-  END IF;[m
[31m-  RETURN NEW;[m
[31m-END;[m
[31m-$$ LANGUAGE plpgsql;[m
[31m-[m
[31m-DROP TRIGGER IF EXISTS trg_un_default_vehiculo ON vehiculo_cliente;[m
[31m-CREATE TRIGGER trg_un_default_vehiculo[m
[31m-  BEFORE INSERT OR UPDATE ON vehiculo_cliente[m
[31m-  FOR EACH ROW EXECUTE FUNCTION fn_un_default_por_cliente();[m
[31m-[m
[31m--- ----- Función helper: buscar o crear cliente desde un canal -----[m
[31m--- Es la que llama el webhook cuando entra un mensaje nuevo.[m
[31m-CREATE OR REPLACE FUNCTION fn_get_or_create_cliente([m
[31m-  p_empresa_id BIGINT,[m
[31m-  p_canal TEXT,[m
[31m-  p_identificador TEXT,[m
[31m-  p_display_name TEXT DEFAULT NULL[m
[31m-) RETURNS BIGINT AS $$[m
[31m-DECLARE[m
[31m-  v_cliente_id BIGINT;[m
[31m-BEGIN[m
[31m-  -- ¿Ya existe el contact_channel?[m
[31m-  SELECT cliente_id INTO v_cliente_id[m
[31m-    FROM contact_channel[m
[31m-   WHERE canal = p_canal AND identificador = p_identificador;[m
[31m-[m
[31m-  IF v_cliente_id IS NOT NULL THEN[m
[31m-    -- Validar que sea de esta empresa; si no, hay que crearle uno nuevo[m
[31m-    PERFORM 1 FROM cliente[m
[31m-     WHERE id = v_cliente_id AND empresa_id = p_empresa_id;[m
[31m-    IF FOUND THEN[m
[31m-      RETURN v_cliente_id;[m
[31m-    END IF;[m
[31m-  END IF;[m
[31m-[m
[31m-  -- Crear cliente nuevo + contact_channel[m
[31m-  INSERT INTO cliente (empresa_id, nombre, primera_actividad_at, ultima_actividad_at)[m
[31m-       VALUES (p_empresa_id, p_display_name, now(), now())[m
[31m-    RETURNING id INTO v_cliente_id;[m
[31m-[m
[31m-  INSERT INTO contact_channel (cliente_id, canal, identificador, display_name)[m
[31m-       VALUES (v_cliente_id, p_canal, p_identificador, p_display_name)[m
[31m-  ON CONFLICT (canal, identificador) DO NOTHING;[m
[31m-[m
[31m-  RETURN v_cliente_id;[m
[31m-END;[m
[31m-$$ LANGUAGE plpgsql;[m
