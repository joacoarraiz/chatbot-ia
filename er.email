[31m-  ON aplicacion(auto_marca, modelo, anio_desde, anio_hasta);[m
[31m-[m
[31m--- ----- EQUIVALENCIA -----[m
[31m--- Códigos de otras marcas / OEM que apuntan al mismo producto lógico.[m
[31m-CREATE TABLE IF NOT EXISTS equivalencia ([m
[31m-  id BIGSERIAL PRIMARY KEY,[m
