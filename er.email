[31m-    """[m
[31m-    try:[m
[31m-        db = get_client()[m
[31m-        result = db.rpc([m
[31m-            "rpc_consultar_precio",[m
[31m-            {"p_empresa_id": empresa_id, "p_producto_id": producto_id},[m
[31m-        ).execute()[m
[31m-        if not result.data:[m
[31m-            return {"error": "sin oferta disponible"}[m
[31m-        return result.data[0] if isinstance(result.data, list) else result.data[m
[31m-    except Exception as e:[m
[31m-        return {"error": f"consultar_precio falló: {str(e)[:200]}"}[m
