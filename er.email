[31m-    total = s_res + s_dat + s_efi + s_ton + s_conv[m
[31m-    banda = calcular_banda(total)[m
[31m-[m
[31m-    # Upsert en score_consulta[m
[31m-    db.table("score_consulta").upsert({[m
[31m-        "consulta_id": consulta_id,[m
